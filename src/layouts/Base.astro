---
import '../styles/global.css';
import '../styles/site.css'; // clay world; must come after global.css (overrides its tokens)
import { t, type Locale } from '../i18n';

interface Props { locale: Locale; title?: string; description?: string; home?: boolean; noindex?: boolean; }
const { locale, title, description, home = false, noindex = false } = Astro.props;
const s = t[locale];
const en = locale === 'en';
const prefix = en ? '/en/' : '/';
const pageTitle = title ? `${title} — ${s.siteTitle}` : s.siteTitle;
const desc = description ?? s.description;
const navHref = (id: string) => (home ? `#${id}` : `${prefix}#${id}`);
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://example.com').href;
// link-preview card, generated by `npm run og` (scripts/make-og.mjs) → public/og-ko.png / og-en.png, 1200×630
const ogImage = new URL(en ? '/og-en.png' : '/og-ko.png', Astro.site ?? 'https://example.com').href;
const navItems = Object.entries(s.nav); // [section id, label]
---
<!doctype html>
<html lang={s.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="color-scheme" content="light" />
    <link rel="preload" href="/fonts/PretendardVariable.woff2" as="font" type="font/woff2" crossorigin />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={s.siteTitle} />
    <meta property="og:locale" content={en ? 'en_US' : 'ko_KR'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${s.hero.name} · ${s.hero.role}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <a class="skip" href="#main">{en ? 'Skip to content' : '본문으로 건너뛰기'}</a>
    <header class="topbar">
      <div class="wrap topbar-in">
        <a class="brand" href={prefix}>{s.hero.name}<span>{s.hero.role.split(' · ')[0]} · DSRV</span></a>
        <nav class="topnav" aria-label={en ? 'Sections' : '섹션'}>
          {navItems.map(([id, label]) => <a href={navHref(id)}>{label}</a>)}
        </nav>
        <a class="pill" href={s.langSwitchHref} lang={en ? 'ko' : 'en'} aria-label={en ? '한국어로 보기' : 'View in English'}>{s.langSwitch}</a>
      </div>
    </header>

    <main id="main"><slot /></main>

    <footer class="footer">
      <div class="wrap footer-in">
        <span class="footer-left">© {new Date().getFullYear()} {s.hero.name}{en ? '' : ' · Juyoung You'}</span>
        <span class="footer-note">{s.footer.note}</span>
      </div>
    </footer>

    <slot name="after" />
  </body>
</html>

<style>
  .skip { position: absolute; left: -999px; top: 0.5rem; z-index: 100; background: var(--color-ink); color: var(--color-paper); padding: 0.5rem 0.8rem; border-radius: var(--radius-sm); font-size: var(--text-sm); }
  .skip:focus { left: 0.5rem; }

  .topbar { position: sticky; top: 0; z-index: 40; background: var(--color-bar); border-bottom: 1px solid var(--color-rule); }
  .topbar-in { display: flex; align-items: center; gap: var(--space-md); min-height: 60px; }
  .brand { display: inline-flex; align-items: center; gap: 0.6rem; min-height: 44px; /* tap target ≥ 44px */ font-weight: 800; font-size: 1.15rem; letter-spacing: -0.03em; text-decoration: none; margin-right: auto; }
  .brand span { font-weight: 500; font-size: var(--text-sm); letter-spacing: 0; color: var(--color-ink-3); }
  .topnav { display: flex; gap: 0.25rem; }
  .topnav a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 0.75rem; border-radius: var(--radius-sm); font-weight: 700; font-size: var(--text-sm); text-decoration: none; }
  .topnav a:hover { background: var(--color-paper-3); }
  .pill { display: inline-grid; place-items: center; min-height: 44px; min-width: 52px; padding: 0 0.85rem; border-radius: var(--radius-sm); border: 1.5px solid var(--color-ink); font-size: var(--text-sm); font-weight: 800; text-decoration: none; }
  .pill:hover { background: var(--color-ink); color: var(--color-paper); }

  .footer { border-top: 1px solid var(--color-rule); padding-block: var(--space-xl); }
  .footer-in { display: flex; flex-wrap: wrap; gap: var(--space-sm) var(--space-xl); align-items: baseline; font-size: var(--text-sm); color: var(--color-ink-3); }
  .footer-left { font-weight: 700; color: var(--color-ink); }
  .footer-note { flex: 1 1 320px; font-size: var(--text-xs); }

  @media (max-width: 640px) {
    .topbar-in { gap: 0.25rem; }
    .brand { flex: none; font-size: 1rem; white-space: nowrap; }
    .brand span { display: none; }
    .topnav { gap: 0; min-width: 0; overflow-x: auto; scrollbar-width: none; } /* below ~340px the links scroll instead of wrapping */
    .topnav a { padding: 0 0.4rem; font-size: 0.8125rem; white-space: nowrap; }
    .pill { min-width: 44px; padding: 0 0.6rem; }
  }
</style>
