---
import '../styles/global.css';
import '../styles/site.css'; // 흑백 테마. global.css의 토큰을 덮어쓰므로 반드시 그 뒤에 불러온다
import { t, type Locale } from '../i18n';
import Icon from '../components/Icon.astro';

interface Props { locale: Locale; title?: string; description?: string; home?: boolean; noindex?: boolean; }
const { locale, title, description, home = false, noindex = false } = Astro.props;
const s = t[locale];
const en = locale === 'en';
const prefix = en ? '/en/' : '/';
const pageTitle = title ? `${title} — ${s.siteTitle}` : s.siteTitle;
const desc = description ?? s.description;
const navHref = (id: string) => (home ? `#${id}` : `${prefix}#${id}`);
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://example.com').href;
// link-preview card, generated by `npm run og` (scripts/make-og.mjs) → public/og-ko.png / og-en.png, 1200×630
const ogImage = new URL(en ? '/og-en.png' : '/og-ko.png', Astro.site ?? 'https://example.com').href;
const navItems = Object.entries(s.nav); // [section id, label]
---
<!doctype html>
<html lang={s.htmlLang} class="no-js" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {/* 탭 아이콘: SVG를 읽는 브라우저는 svg(화면 밝기에 따라 뒤집힘), 못 읽으면 ico */}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="color-scheme" content="dark light" />
    <link rel="preload" href="/fonts/PretendardVariable.woff2" as="font" type="font/woff2" crossorigin />
    {/* 첫 화면이 그려지기 전에 테마를 정해야 밝은 테마를 고른 사람에게 어두운 화면이 번쩍이지 않는다 */}
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.remove('no-js'); d.classList.add('js');
        try { if (localStorage.getItem('theme') === 'light') d.dataset.theme = 'light'; } catch (e) { /* 저장소가 막힌 브라우저: 기본(어두운) 테마 그대로 */ }
      })();
    </script>
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={s.siteTitle} />
    <meta property="og:locale" content={en ? 'en_US' : 'ko_KR'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${s.hero.name} · ${s.hero.role}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    {/* 화면 전체 바탕의 점 무늬. 화면에 고정돼 있고 본문은 그 위로 지나간다 (아래 스크립트가 그린다) */}
    <canvas class="field" aria-hidden="true"></canvas>
    <a class="skip" href="#main">{en ? 'Skip to content' : '본문으로 건너뛰기'}</a>
    <header class="topbar">
      <div class="topbar-in">
        {/* 머리글은 분야만: "HR Operations"는 행정 처리 직무로 좁게 읽혀 2026-11-03 "HR"로 고정. 개인 포트폴리오라 회사명(DSRV)은 머리글에 넣지 않음(2026-11-17). role 값은 /print/에서 그대로 씀 */}
        <a class="brand" href={prefix}>{s.hero.name}<span>HR</span></a>
        <nav class="topnav" aria-label={en ? 'Sections' : '섹션'}>
          {navItems.map(([id, label]) => <a href={navHref(id)} data-spy={id}>{label}</a>)}
        </nav>
        <a class="lang" href={s.langSwitchHref} lang={en ? 'ko' : 'en'} aria-label={en ? '한국어로 보기' : 'View in English'}><Icon name="globe" size={18} />{s.langSwitch}</a>
        <button type="button" class="theme" aria-label={s.home.themeToggle}>
          <span class="when-dark"><Icon name="sun" size={20} /></span><span class="when-light"><Icon name="moon" size={20} /></span>
        </button>
      </div>
    </header>

    <main id="main"><slot /></main>

    <footer class="footer">
      <div class="wrap footer-in">
        <span class="footer-left">© {new Date().getFullYear()} {s.hero.name}{en ? '' : ' · Juyoung You'}</span>
        <span class="footer-note">{s.footer.note}</span>
      </div>
    </footer>

    <slot name="after" />
  </body>
</html>

<script>
  const root = document.documentElement;
  document.querySelector('.theme')?.addEventListener('click', () => {
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch { /* 저장이 막혀도 이번 화면에서는 바뀐다 */ }
  });

  // 화면에 들어온 요소를 한 번만 등장시킨다 (.rv → .in)
  const seen = new IntersectionObserver((entries) => {
    for (const e of entries) if (e.isIntersecting) { e.target.classList.add('in'); seen.unobserve(e.target); }
  }, { rootMargin: '0px 0px -8% 0px' });
  document.querySelectorAll('.rv').forEach((el) => seen.observe(el));

  // 지금 보고 있는 구역을 메뉴에 표시
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.topnav a[data-spy]')];
  const targets = links.map((a) => document.getElementById(a.dataset.spy!)).filter((el): el is HTMLElement => !!el);
  if (targets.length) {
    const mark = () => {
      const line = window.scrollY + window.innerHeight * 0.4;
      let on = '';
      for (const el of targets) if (el.getBoundingClientRect().top + window.scrollY <= line) on = el.id;
      links.forEach((a) => (a.dataset.spy === on ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
    };
    addEventListener('scroll', mark, { passive: true });
    mark();
  }

  // ── 화면 바탕의 점 무늬: 마우스 근처 점이 밝아지며 살짝 밀려난다 ──
  // 마우스가 있는 기기에서만 그린다(휴대폰·"움직임 줄이기"에서는 빈 바탕). 마우스가 움직일 때만 다시 그리므로 스크롤에는 비용이 없다.
  const field = document.querySelector<HTMLCanvasElement>('.field');
  const fctx = field?.getContext('2d');
  if (field && fctx && !matchMedia('(prefers-reduced-motion: reduce)').matches && matchMedia('(hover: hover) and (pointer: fine)').matches) {
    const GAP = 26;      // ← 점 사이 간격(px)
    const REACH = 180;   // ← 마우스가 영향을 주는 반경(px)
    const MID = 0.3;     // ← 본문이 지나가는 가운데 기둥의 점 세기 (1 = 양옆 여백과 같게, 0 = 가운데는 비움)
    let fw = 0, fh = 0, offX = 0, offY = 0, half = 0, ink = '#fff', clear = 'rgba(255,255,255,0)';
    let mx = -999, my = -999, tx = -999, ty = -999, lit = 0, litTo = 0, fraf = 0;
    // 가운데 기둥(본문 폭)에서는 MID, 양옆 여백으로 나가면서 1까지 올라간다
    const weight = (x: number) => {
      const u = Math.min(1, Math.max(0, (Math.abs(x - fw / 2) - (half - 40)) / 120));
      return MID + (1 - MID) * u * u * (3 - 2 * u);
    };
    const paint = () => {
      fctx.clearRect(0, 0, fw, fh);
      if (lit > 0.01) { // 마우스 자리의 옅은 빛
        const g = fctx.createRadialGradient(mx, my, 0, mx, my, REACH * 1.5);
        g.addColorStop(0, ink); g.addColorStop(1, clear);
        fctx.globalAlpha = 0.07 * lit * weight(mx); fctx.fillStyle = g; fctx.fillRect(mx - REACH * 1.5, my - REACH * 1.5, REACH * 3, REACH * 3);
      }
      fctx.fillStyle = ink;
      for (let x = (fw % GAP) / 2 + GAP / 2; x < fw; x += GAP) {
        const w = weight(x);
        for (let y = (fh % GAP) / 2 + GAP / 2; y < fh; y += GAP) {
          const dx = x - mx, dy = y - my, d = Math.hypot(dx, dy) || 1;
          const k = d < REACH ? Math.pow(1 - d / REACH, 2) * lit : 0;
          fctx.globalAlpha = (0.1 + 0.6 * k) * w;
          fctx.beginPath(); fctx.arc(x + (dx / d) * 7 * k, y + (dy / d) * 7 * k, 1 + 1.1 * k * w, 0, 6.2832); fctx.fill(); // 본문 뒤에서는 점이 덜 밝고 덜 커진다(w)
        }
      }
    };
    const size = () => {
      const dpr = Math.min(devicePixelRatio || 1, 2);
      const r = field.getBoundingClientRect();
      fw = r.width; fh = r.height; offX = r.left; offY = r.top;
      field.width = Math.round(fw * dpr); field.height = Math.round(fh * dpr); fctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const cs = getComputedStyle(root);
      half = (parseFloat(cs.getPropertyValue('--page-max')) * parseFloat(cs.fontSize)) / 2; // 본문 최대 폭(rem)의 절반을 px로
      if (!(half > 0)) throw new Error('Base.astro dot field: --page-max is missing or not a rem length, so the content column cannot be located.');
      ink = getComputedStyle(field).color; clear = ink.replace('rgb(', 'rgba(').replace(')', ', 0)');
      paint();
    };
    const tick = () => {
      mx += (tx - mx) * 0.2; my += (ty - my) * 0.2; lit += (litTo - lit) * 0.12;
      paint();
      fraf = Math.abs(tx - mx) + Math.abs(ty - my) > 0.4 || Math.abs(litTo - lit) > 0.01 ? requestAnimationFrame(tick) : 0;
    };
    const wake = () => { if (!fraf) fraf = requestAnimationFrame(tick); };
    addEventListener('pointermove', (e) => {
      tx = e.clientX - offX; ty = e.clientY - offY;
      if (lit < 0.02) { mx = tx; my = ty; } // 처음 들어올 때는 멀리서 끌려오지 않고 그 자리에서 켜진다
      litTo = 1; wake();
    }, { passive: true });
    root.addEventListener('pointerleave', () => { litTo = 0; wake(); });
    addEventListener('resize', size);
    new MutationObserver(size).observe(root, { attributes: true, attributeFilter: ['data-theme'] });
    size();
  }
</script>

<style>
  /* 바탕색(body) 바로 위, 모든 내용 아래. 메뉴 막대 밑에서 시작한다 */
  .field { position: fixed; inset: var(--bar-h) 0 0 0; z-index: -1; width: 100%; height: calc(100% - var(--bar-h)); pointer-events: none; color: var(--color-ink); }

  .skip { position: absolute; left: -999px; top: 0.5rem; z-index: 100; background: var(--color-ink); color: var(--color-paper); padding: 0.5rem 0.8rem; border-radius: var(--radius-sm); font-size: var(--text-sm); }
  .skip:focus { left: 0.5rem; }

  .topbar { position: sticky; top: 0; z-index: 40; height: var(--bar-h); background: var(--color-bar); backdrop-filter: blur(14px) saturate(1.4); -webkit-backdrop-filter: blur(14px) saturate(1.4); border-bottom: 1px solid var(--color-rule); }
  .topbar-in { display: flex; align-items: stretch; gap: 0.25rem; height: 100%; max-width: 82rem; margin-inline: auto; padding-inline: clamp(0.75rem, 3vw, 2rem); }
  .brand { display: inline-flex; flex: none; align-items: center; gap: 0.6rem; padding-right: 0.75rem; font-weight: 700; font-size: 1.0625rem; letter-spacing: -0.02em; text-decoration: none; white-space: nowrap; }
  .brand span { font-weight: 500; font-size: var(--text-sm); letter-spacing: 0; color: var(--color-ink-3); }
  .topnav { display: flex; margin-right: auto; }
  .topnav a { position: relative; display: inline-flex; align-items: center; padding: 0 0.8rem; font-weight: 500; font-size: 0.9375rem; color: var(--color-ink-2); text-decoration: none; white-space: nowrap; transition: color var(--dur-base); }
  .topnav a:hover, .topnav a[aria-current] { color: var(--color-ink); }
  /* 보고 있는 구역 아래에 굵은 밑줄 */
  .topnav a::after { content: ""; position: absolute; left: 0.4rem; right: 0.4rem; bottom: -1px; height: 2px; border-radius: 2px; background: var(--color-ink); transform: scaleX(0); transition: transform 0.3s var(--ease-spring); }
  .topnav a[aria-current]::after { transform: scaleX(1); }
  .lang { display: inline-flex; flex: none; align-items: center; gap: 0.35rem; padding: 0 0.7rem; white-space: nowrap; font-weight: 600; font-size: 0.9375rem; text-decoration: none; }
  .theme { display: grid; flex: none; place-items: center; width: 44px; border: 0; background: none; color: var(--color-ink); cursor: pointer; }
  .theme span { grid-area: 1 / 1; display: grid; transition: opacity 0.3s, transform 0.5s var(--ease-spring); }
  :global([data-theme="light"]) .theme .when-dark, :global([data-theme="dark"]) .theme .when-light { opacity: 0; transform: rotate(-90deg) scale(0.4); }
  .lang:hover, .theme:hover { color: var(--color-ink); background: var(--color-accent-soft); }
  .lang, .theme { color: var(--color-ink-2); border-radius: 0; }

  .footer { border-top: 1px solid var(--color-rule); padding-block: var(--space-xl); }
  .footer-in { display: flex; flex-wrap: wrap; gap: var(--space-sm) var(--space-xl); align-items: baseline; font-size: var(--text-sm); color: var(--color-ink-3); }
  .footer-left { font-weight: 600; color: var(--color-ink); }
  .footer-note { flex: 1 1 320px; font-size: var(--text-xs); }

  @media (max-width: 640px) {
    .brand { font-size: 1rem; padding-right: 0.25rem; }
    .brand span { display: none; }
    .topnav { min-width: 0; overflow-x: auto; scrollbar-width: none; } /* 아주 좁은 화면에서는 줄바꿈 대신 옆으로 밀린다 */
    .topnav a { padding: 0 0.45rem; font-size: 0.8125rem; }
    .lang { padding: 0 0.4rem; font-size: 0.8125rem; }
    .lang :global(svg) { display: none; }
    .theme { width: 40px; }
  }
</style>
