---
import '../styles/global.css';
import { t, HIRE_DATE, type Locale } from '../i18n';
import Wordmark from '../components/Wordmark.astro';
import Icon from '../components/Icon.astro';

interface Props { locale: Locale; title?: string; description?: string; home?: boolean; noindex?: boolean; }
const { locale, title, description, home = false, noindex = false } = Astro.props;
const s = t[locale];
const en = locale === 'en';
const prefix = en ? '/en/' : '/';
const pageTitle = title ? `${title} — ${s.siteTitle}` : s.siteTitle;
const desc = description ?? s.description;
const navHref = (id: string) => (home ? `#${id}` : `${prefix}#${id}`);
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://example.com').href;
// link-preview card, generated by `npm run og` (scripts/make-og.mjs) → public/og-ko.png / og-en.png, 1200×630
const ogImage = new URL(en ? '/og-en.png' : '/og-ko.png', Astro.site ?? 'https://example.com').href;
// icon nav: [section id, icon, label]
const navItems: [string, 'home' | 'grid' | 'scale' | 'list' | 'mail', string][] = [
  ['record', 'home', s.nav.record],
  ['modules', 'grid', s.nav.modules],
  ['policy', 'scale', s.nav.policy],
  ['log', 'list', s.nav.log],
  ['contact', 'mail', s.nav.contact],
];
---
<!doctype html>
<html lang={s.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      // Apply the saved theme before first paint to avoid a light→dark flash.
      (function () {
        try {
          var t = localStorage.getItem('ui-theme');
          if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          document.documentElement.dataset.theme = t;
        } catch (e) { document.documentElement.dataset.theme = 'light'; }
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={s.siteTitle} />
    <meta property="og:locale" content={en ? 'en_US' : 'ko_KR'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${s.hero.name} · ${s.hero.role}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <a class="skip" href="#main">{en ? 'Skip to content' : '본문으로 건너뛰기'}</a>
    <header class="topbar">
      <div class="wrap topbar-in">
        <a class="brand" href={prefix} aria-label={en ? 'Home' : '홈'}><Wordmark /></a>
        <nav class="topnav" aria-label="Sections">
          {navItems.map(([id, icon, label]) => (
            <a class="ibtn ghost" href={navHref(id)} aria-label={label} data-tip={label}><Icon name={icon} /></a>
          ))}
        </nav>
        <div class="topbar-right">
          <span class="tenure mono" data-tenure data-hire={HIRE_DATE} aria-live="off"></span>
          <button class="ibtn ghost" type="button" data-open-palette aria-label={s.search} data-tip={`${s.search} ⌘K`}><Icon name="search" /></button>
          <a class="pill" href={s.langSwitchHref} lang={en ? 'ko' : 'en'} aria-label={en ? '한국어로 보기' : 'View in English'}>{s.langSwitch}</a>
          <button class="ibtn outline theme" type="button" data-theme-toggle aria-label={en ? 'Dark mode' : '다크 모드'}>
            <span class="ic-sun"><Icon name="sun" /></span>
            <span class="ic-moon"><Icon name="moon" /></span>
          </button>
        </div>
      </div>
    </header>

    <main id="main"><slot /></main>

    <footer class="footer">
      <div class="wrap footer-in">
        <span class="footer-left">© {new Date().getFullYear()} <Wordmark tag="" size="sm" /></span>
        <span class="footer-note">{s.footer.note}</span>
      </div>
    </footer>

    <slot name="after" />
    <script>
      import '../scripts/tenure.ts';
      import '../scripts/theme.ts';
      import '../scripts/view.ts';
    </script>
  </body>
</html>

<style>
  .skip { position: absolute; left: -999px; top: 0.5rem; z-index: 100; background: var(--color-ink); color: var(--color-paper); padding: 0.5rem 0.8rem; border-radius: 999px; font-size: var(--text-sm); }
  .skip:focus { left: 0.5rem; }

  .topbar {
    position: sticky; top: 0; z-index: 40;
    background: var(--color-bar);
    backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px);
  }
  .topbar-in { display: grid; grid-template-columns: max-content minmax(0, 1fr) max-content; align-items: center; gap: var(--space-xs); min-height: 56px; }
  .brand { display: inline-flex; align-items: center; min-height: 44px; /* tap target ≥ 44px (Apple HIG); visual size unchanged */ text-decoration: none; padding: 0.4rem 0.5rem; margin-left: -0.5rem; border-radius: 999px; }
  .brand:hover { background: var(--color-paper-3); }
  .topnav { display: flex; justify-content: flex-end; gap: 0.15rem; }
  .topbar-right { display: flex; align-items: center; gap: 0.35rem; }

  /* 40px round icon buttons, ghost + outline variants */
  .ibtn { position: relative; display: inline-grid; place-items: center; width: 40px; height: 40px; border-radius: 999px; color: var(--color-ink-2); background: transparent; border: 1px solid transparent; cursor: pointer; text-decoration: none; padding: 0; font: inherit; transition: background var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out); }
  .ibtn:hover { background: var(--color-paper-3); color: var(--color-ink); }
  .ibtn:active { transform: translateY(1px); }
  .ibtn.outline { border-color: var(--color-rule-strong); }
  .pill { display: inline-grid; place-items: center; height: 40px; min-width: 52px; padding: 0 0.85rem; border-radius: 999px; border: 1px solid var(--color-rule-strong); color: var(--color-ink); font-size: var(--text-sm); font-weight: 600; text-decoration: none; }
  .pill:hover { background: var(--color-paper-3); }
  .tenure { font-size: var(--text-xs); color: var(--color-ink-3); white-space: nowrap; margin-right: 0.4rem; }
  .tenure:empty { display: none; }

  /* theme toggle: show the icon of the mode you would switch TO */
  .theme .ic-moon, .theme .ic-sun { display: grid; place-items: center; grid-area: 1 / 1; }
  :root[data-theme="dark"] .theme .ic-moon { display: none; }
  :root:not([data-theme="dark"]) .theme .ic-sun { display: none; }

  /* tooltip (hover, pointer devices only) */
  [data-tip]::after {
    content: attr(data-tip); position: absolute; top: calc(100% + 8px); left: 50%; transform: translateX(-50%) translateY(-2px);
    background: var(--color-ink); color: var(--color-paper); font-size: var(--text-xs); font-weight: 600; white-space: nowrap;
    padding: 0.35rem 0.6rem; border-radius: 8px; pointer-events: none; opacity: 0;
    transition: opacity var(--dur-fast) var(--ease-out) 500ms, transform var(--dur-fast) var(--ease-out) 500ms;
  }
  @media (hover: hover) and (pointer: fine) {
    [data-tip]:hover::after { opacity: 1; transform: translateX(-50%) translateY(0); }
  }

  .footer { border-top: var(--rule); margin-top: var(--space-3xl); padding-block: var(--space-xl); }
  .footer-in { display: flex; flex-wrap: wrap; gap: var(--space-sm) var(--space-xl); align-items: center; font-size: var(--text-sm); color: var(--color-ink-3); }
  .footer-left { display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 600; letter-spacing: 0.04em; }
  .footer-note { flex: 1 1 320px; font-size: var(--text-xs); }

  @media (max-width: 860px) { .tenure { display: none; } }
  @media (max-width: 640px) { .topnav { display: none; } .topbar-in { grid-template-columns: max-content 1fr; } .topbar-right { justify-self: end; } }
</style>
