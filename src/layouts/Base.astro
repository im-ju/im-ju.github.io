---
import '../styles/global.css';
import { t, HIRE_DATE, type Locale } from '../i18n';

interface Props { locale: Locale; title?: string; description?: string; home?: boolean; }
const { locale, title, description, home = false } = Astro.props;
const s = t[locale];
const prefix = locale === 'en' ? '/en/' : '/';
const pageTitle = title ? `${title} — ${s.siteTitle}` : s.siteTitle;
const desc = description ?? s.description;
const nav = Object.entries(s.nav) as [string, string][];
const navHref = (id: string) => (home ? `#${id}` : `${prefix}#${id}`);
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://example.com').href;
---
<!doctype html>
<html lang={s.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/PretendardVariable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <header class="topbar">
      <div class="wrap topbar-in">
        <a class="brand mono" href={prefix} aria-label="Home">
          <span class="brand-dot" aria-hidden="true"></span>JUYOUNG.YOU<span class="brand-tail"><span class="brand-sep">/</span>HR×AX</span>
        </a>
        <nav class="topnav" aria-label="Sections">
          {nav.map(([id, label]) => <a href={navHref(id)}>{label}</a>)}
        </nav>
        <div class="topbar-right">
          <span class="tenure mono" data-tenure data-hire={HIRE_DATE} aria-live="off"></span>
          <button class="search-btn mono" type="button" data-open-palette aria-label={s.search}>
            {s.search} <kbd>⌘K</kbd>
          </button>
          <a class="lang mono" href={s.langSwitchHref} lang={locale === 'ko' ? 'en' : 'ko'}>{s.langSwitch}</a>
        </div>
      </div>
    </header>

    <main id="main"><slot /></main>

    <footer class="footer">
      <div class="wrap footer-in">
        <span class="mono footer-brand">{s.footer.line}</span>
        <span class="footer-note">{s.footer.note}</span>
        <span class="mono footer-built">{s.footer.built} · © {new Date().getFullYear()}</span>
      </div>
    </footer>

    <slot name="after" />
    <script>
      import '../scripts/tenure.ts';
    </script>
  </body>
</html>

<style>
  .topbar {
    position: sticky; top: 0; z-index: 20;
    background: color-mix(in oklch, var(--color-paper) 88%, transparent);
    backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
    border-bottom: var(--rule);
  }
  .topbar-in { display: flex; align-items: center; gap: var(--space-lg); height: 52px; }
  .brand { display: inline-flex; align-items: center; gap: 0.5em; font-size: var(--text-xs); letter-spacing: 0.06em; text-decoration: none; color: var(--color-ink); white-space: nowrap; }
  .brand-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--color-accent); box-shadow: 0 0 0 3px var(--color-accent-soft); }
  .brand-sep { color: var(--color-ink-3); margin-inline: 0.15em; }
  .topnav { display: flex; gap: var(--space-md); margin-inline: auto; }
  .topnav a { font-size: var(--text-sm); color: var(--color-ink-2); text-decoration: none; padding: 0.35em 0.15em; white-space: nowrap; border-bottom: 1px solid transparent; }
  .topnav a:hover { color: var(--color-ink); border-bottom-color: var(--color-ink); }
  .topbar-right { display: flex; align-items: center; gap: var(--space-sm); margin-left: auto; }
  .tenure { font-size: var(--text-xs); color: var(--color-ink-3); white-space: nowrap; }
  .tenure:empty { display: none; }
  .search-btn { display: inline-flex; align-items: center; gap: 0.5em; font-size: var(--text-xs); letter-spacing: 0.04em; color: var(--color-ink-2); background: var(--color-paper-2); border: var(--rule); border-radius: 999px; padding: 0.3rem 0.5rem 0.3rem 0.75rem; cursor: pointer; white-space: nowrap; }
  .search-btn:hover { border-color: var(--color-ink-3); color: var(--color-ink); }
  .search-btn kbd { background: var(--color-paper); }
  .lang { font-size: var(--text-xs); letter-spacing: 0.06em; text-decoration: none; padding: 0.3rem 0.6rem; border: var(--rule); border-radius: 999px; color: var(--color-ink-2); white-space: nowrap; }
  .lang:hover { border-color: var(--color-ink); color: var(--color-ink); }

  .footer { border-top: var(--rule); margin-top: var(--space-3xl); padding-block: var(--space-lg); }
  .footer-in { display: flex; flex-wrap: wrap; gap: var(--space-xs) var(--space-lg); align-items: baseline; font-size: var(--text-xs); color: var(--color-ink-3); }
  .footer-brand { color: var(--color-ink-2); letter-spacing: 0.06em; }
  .footer-note { flex: 1 1 320px; }
  .footer-built { margin-left: auto; letter-spacing: 0.04em; }

  @media (max-width: 860px) {
    .topnav { display: none; }
    .tenure { display: none; }
  }
  @media (max-width: 480px) {
    .brand-tail { display: none; }
    .search-btn kbd { display: none; }
  }
</style>
