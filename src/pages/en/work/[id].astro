---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Work from '../../../components/Work.astro';
export async function getStaticPaths() {
  return (await getCollection('projects')).map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
---
<Base locale="en" title={entry.data.titleEn} description={entry.data.summaryEn}><Work locale="en" entry={entry} /></Base>
