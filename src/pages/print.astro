---
// Print edition of the site → PDF for application forms that only accept jpg/png/pdf.
// Same content sources as the home page (i18n.ts + content collection). Korean only. A4 portrait.
// Generate: npm run pdf  (see scripts/make-pdf.mjs)
import '../styles/global.css';
import { getCollection } from 'astro:content';
import { t, EMAIL, LINKEDIN, STATUS_LABEL } from '../i18n';
import Wordmark from '../components/Wordmark.astro';

const s = t.ko;
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const today = new Date(Date.now() + 9 * 3600e3).toISOString().slice(0, 10); // KST
---
<!doctype html>
<html lang="ko" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>유주영 — HR × AX 포트폴리오 (인쇄판)</title>
    <meta name="robots" content="noindex" />
    <link href="https://fonts.googleapis.com/css2?family=Bagel+Fat+One&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body class="print">
    <!-- 1 · 표지 = 인사기록 카드 -->
    <section class="page cover">
      <header class="cover-top">
        <Wordmark />
        <span class="mono muted">PORTFOLIO · {today}</span>
      </header>
      <div class="cover-body">
        <div>
          <p class="label">{s.hero.eyebrow}</p>
          <h1 class="cover-name">{s.hero.name}<span class="cover-role"> · {s.hero.role}</span></h1>
          <p class="cover-statement">{s.hero.statement}</p>
          <p class="cover-sub">{s.hero.sub}</p>
        </div>
        <aside class="card">
          <img src="/juyoung.jpg" alt="" width="800" height="800" />
          <dl class="record">
            {s.hero.fields.map(([k, v]) => (<><dt>{k}</dt><dd>{v}</dd></>))}
            <dt>연락</dt><dd>{EMAIL}<br />{LINKEDIN.replace('https://', '')}</dd>
          </dl>
        </aside>
      </div>
      <footer class="cover-foot">
        <p class="label">목차</p>
        <ol class="toc">
          <li>모듈 — 직접 만들어 운영한 도구 {projects.length}건</li>
          <li>운영 규정 — 여덟 프로젝트를 관통하는 원칙 5조</li>
          <li>이력 로그 — 2024.12 이후 주요 기록</li>
        </ol>
      </footer>
    </section>

    <!-- 2 · 모듈 -->
    <section class="page">
      <p class="label">MODULES · {String(projects.length).padStart(2, '0')}</p>
      <h2>{s.modules.title}</h2>
      <p class="lede">{s.modules.lede}</p>
      <div class="modules">
        {projects.map((p) => (
          <article class="module">
            <div class="module-top">
              <span class="mono module-id">MOD-{String(p.data.order).padStart(2, '0')}</span>
              <span class="label">{p.data.module}</span>
              <span class="status" data-status={p.data.status}>{STATUS_LABEL.ko[p.data.status]}</span>
            </div>
            <h3>{p.data.title}</h3>
            <p class="module-summary">{p.data.summary}</p>
            <dl class="module-meta">
              <dt>기간</dt><dd>{p.data.period}</dd>
              <dt>{s.modules.replaced}</dt><dd>{p.data.replaced}</dd>
              <dt>스택</dt><dd class="mono">{p.data.stack.join(' · ')}</dd>
            </dl>
          </article>
        ))}
      </div>
      <p class="label summary-title">한 줄 요약</p>
      <table class="silent">
        <thead><tr><th>모듈</th><th>무엇을 대체했나</th><th>상태</th></tr></thead>
        <tbody>{projects.map((p) => <tr><td>{p.data.title}</td><td class="muted">{p.data.replaced}</td><td class="fix">{STATUS_LABEL.ko[p.data.status]} · {p.data.period}</td></tr>)}</tbody>
      </table>
    </section>

    <!-- 3 · 운영 규정 -->
    <section class="page">
      <p class="label">POLICY · 2026-09 개정</p>
      <h2>{s.policy.title}</h2>
      <p class="lede">{s.policy.lede}</p>
      <ol class="articles">
        {s.policy.articles.map(([no, head, body]) => (
          <li class="article"><span class="mono article-no">{no}</span><div><h3>{head}</h3><p>{body}</p></div></li>
        ))}
      </ol>
      <p class="label silent-title">{s.policy.silentTitle}</p>
      <table class="silent">
        <thead><tr>{s.policy.silentHead.map((h) => <th>{h}</th>)}</tr></thead>
        <tbody>{s.policy.silent.map(([a, b, c]) => <tr><td>{a}</td><td class="muted">{b}</td><td class="fix">{c}</td></tr>)}</tbody>
      </table>
    </section>

    <!-- 4 · 이력 로그 -->
    <section class="page">
      <p class="label">LOG · 2024-12-05 이후</p>
      <h2>{s.log.title}</h2>
      <p class="lede">{s.log.lede}</p>
      <ol class="log">
        {s.log.entries.map(([when, head, body]) => (
          <li class="log-row"><span class="mono log-when">{when}</span><span class="log-head">{head}</span><span class="log-body">{body}</span></li>
        ))}
      </ol>
      <footer class="end">
        <p class="muted small">{s.footer.note}</p>
      </footer>
    </section>
  </body>
</html>

<style is:global>
  /* A4 portrait; margins handled by @page so content can use the full width */
  @page { size: A4 portrait; margin: 14mm 14mm 16mm; }
  html, body { background: #fff; }
  body.print { color: var(--color-ink); font-size: 10.5pt; line-height: 1.55; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  .page { break-after: page; page-break-after: always; }
  .page:last-child { break-after: auto; page-break-after: auto; }
  .page h2 { font-size: 26pt; letter-spacing: -0.04em; margin: 0.15em 0 0.3em; }
  .page h3 { font-size: 12.5pt; letter-spacing: -0.03em; }
  .lede { color: var(--color-ink-2); max-width: 62ch; margin-bottom: 7mm; }
  .muted { color: var(--color-ink-3); }
  .small { font-size: 8.5pt; }
  .mono { font-family: var(--font-mono); font-size: 0.86em; }

  /* cover */
  .cover { display: flex; flex-direction: column; min-height: 258mm; }
  .cover-top { display: flex; justify-content: space-between; align-items: center; padding-bottom: 6mm; border-bottom: var(--rule); }
  .cover-body { display: grid; grid-template-columns: 1fr; gap: 10mm; padding-top: 12mm; }
  .cover-name { font-size: 34pt; letter-spacing: -0.05em; line-height: 1.05; margin: 2mm 0 4mm; }
  .cover-role { display: block; font-size: 12pt; font-weight: 500; color: var(--color-ink-3); margin-top: 2mm; letter-spacing: -0.01em; }
  .cover-statement { font-size: 14pt; font-weight: 700; letter-spacing: -0.03em; line-height: 1.35; max-width: 30ch; margin-bottom: 4mm; }
  .cover-sub { color: var(--color-ink-2); }
  .card { border: var(--rule); border-radius: 10px; padding: 5mm; background: var(--color-paper); display: grid; grid-template-columns: 34mm 1fr; gap: 6mm; align-items: start; max-width: 150mm; }
  .card dd { overflow-wrap: normal; word-break: keep-all; }
  .card img { width: 100%; height: auto; aspect-ratio: 3 / 4; object-fit: cover; object-position: top; border-radius: 6px; }
  .record { font-size: 9.5pt; row-gap: 2mm; grid-template-columns: 14mm 1fr; }
  .cover-foot { margin-top: auto; padding-top: 6mm; border-top: var(--rule); }
  .toc { margin: 1mm 0 0; padding-left: 1.2em; color: var(--color-ink-2); }

  /* modules: 2 columns, 4 rows → fits one A4 page */
  .modules { display: grid; grid-template-columns: 1fr 1fr; gap: 4mm; }
  .module { border: var(--rule); border-radius: 8px; padding: 4mm 4.5mm; break-inside: avoid; page-break-inside: avoid; }
  .module-top { display: flex; align-items: center; gap: 2mm; margin-bottom: 1.5mm; }
  .module-id { font-size: 8pt; letter-spacing: 0.06em; }
  .module-top .status { margin-left: auto; font-size: 7.5pt; }
  .module h3 { margin: 0 0 1.5mm; }
  .module-summary { font-size: 9pt; color: var(--color-ink-2); margin-bottom: 2.5mm; }
  .module-meta { display: grid; grid-template-columns: max-content 1fr; gap: 0.8mm 3mm; margin: 0; font-size: 8.5pt; border-top: var(--rule); padding-top: 2mm; }
  .module-meta dt { font-family: var(--font-mono); font-size: 7pt; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-ink-3); padding-top: 0.3em; }
  .module-meta dd { margin: 0; }

  /* policy */
  .articles { list-style: none; margin: 0; padding: 0; border-top: var(--rule); }
  .article { display: grid; grid-template-columns: 16mm 1fr; gap: 5mm; padding: 4mm 0; border-bottom: var(--rule); break-inside: avoid; }
  .article-no { color: var(--color-accent-ink); font-size: 9.5pt; padding-top: 0.2em; }
  .article h3 { margin: 0 0 1mm; }
  .article p { color: var(--color-ink-2); font-size: 9.5pt; }
  .silent-title, .summary-title { margin-top: 7mm; }
  .silent { width: 100%; border-collapse: collapse; font-size: 9pt; margin-top: 2mm; }
  .silent th { text-align: left; font-family: var(--font-mono); font-size: 7pt; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-ink-3); font-weight: 500; padding: 2mm 3mm 2mm 0; border-bottom: 1px solid var(--color-rule-strong); }
  .silent td { vertical-align: top; padding: 2mm 3mm 2mm 0; border-bottom: var(--rule); }
  .fix { color: var(--color-accent-ink); }

  /* log */
  .log { list-style: none; margin: 0; padding: 0; border-top: var(--rule); }
  .log-row { display: grid; grid-template-columns: 18mm 34mm 1fr; gap: 4mm; padding: 3mm 0; border-bottom: var(--rule); font-size: 9.5pt; break-inside: avoid; }
  .log-when { color: var(--color-ink-3); font-size: 8pt; padding-top: 0.3em; }
  .log-head { font-weight: 700; }
  .log-body { color: var(--color-ink-2); }
  .end { margin-top: 8mm; padding-top: 4mm; border-top: var(--rule); font-size: 9.5pt; display: grid; gap: 2mm; }
</style>
