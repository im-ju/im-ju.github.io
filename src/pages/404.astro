---
// Custom 404 in the console voice. GitHub Pages serves /404.html for any unknown path, so this is
// bilingual on one page: Korean first, English line below. Not indexed (see Base: noindex prop).
import Base from '../layouts/Base.astro';
---
<Base locale="ko" title="404" description="요청한 기록이 없습니다." noindex>
  <section class="wrap nf">
    <h1 class="nf-code">404</h1>
    <p class="nf-lede">요청한 주소에 해당하는 기록이 없습니다. 주소가 바뀌었거나 처음부터 없던 항목입니다.</p>
    <p class="nf-lede nf-en" lang="en">No record at this address. It may have moved, or it never existed.</p>
    <div class="nf-actions">
      <a class="btn" href="/">홈으로</a>
      <a class="btn ghost" href="/#files">작업 파일</a>
      <a class="btn ghost" href="/en/" lang="en">English</a>
    </div>
  </section>
</Base>

<style>
  .nf { padding-block: var(--space-2xl); display: grid; justify-items: start; gap: var(--space-md); }
  .nf-code { font-size: var(--text-display); letter-spacing: -0.04em; line-height: 1; }
  .nf-lede { max-width: var(--measure); font-size: var(--text-lg); color: var(--color-ink-2); }
  .nf-en { color: var(--color-ink-3); font-size: var(--text-base); }
  .nf-actions { display: flex; flex-wrap: wrap; gap: var(--space-sm); margin-top: var(--space-sm); }
</style>
