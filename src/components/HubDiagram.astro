---
// Explanatory diagram of HR/GA Hub for the HR-01 sheet. NOT a screenshot of the internal app: drawn only from
// the six features the write-up already publishes (src/content/projects/hrga-hub.md §3). No names, no numbers.
const modules = [
  ['회의실 대시보드', '예약 현황 · 오늘 일정 · 빈 시간 추천'],
  ['이벤트 랜덤픽', '블라인드 런치 · 치맥파티 조 편성'],
  ['구성원 디렉토리', '전 직원 명단 · 조직도'],
  ['제휴식당', '카테고리 · 지역 · 사무실 거리순 검색'],
  ['자기계발비', '개인 한도 · 잔여 · 사용 내역'],
  ['근속 · 생일', '매일 아침 Slack 알림'],
];
---
<figure class="hub">
  <div class="hub-frame" aria-hidden="true">
    <div class="hub-bar"><b>HR/GA Hub</b><span>회사 Google 계정으로 로그인</span></div>
    <ul class="hub-grid">
      {modules.map(([name, does], i) => (
        <li data-clay={i % 5}><b>{name}</b><span>{does}</span></li>
      ))}
    </ul>
  </div>
  <figcaption><strong>설명용 그림 · 실제 화면 아님.</strong> 사이트에 공개된 6개 기능 설명만으로 그렸습니다. 기능: {modules.map(([n]) => n).join(', ')}.</figcaption>
</figure>

<style>
  .hub { margin: 1.25rem 0 0; }
  .hub-frame { border: 1.5px solid var(--color-ink); border-radius: var(--radius-md); overflow: hidden; background: var(--color-paper); }
  .hub-bar { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.25rem 1rem; padding: 0.7rem 1rem; background: var(--color-ink); color: #fff; font-size: var(--text-sm); }
  .hub-bar span { color: #cfc8b4; }
  .hub-grid { list-style: none; margin: 0; padding: 0.9rem; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.6rem; }
  .hub-grid li { display: grid; gap: 0.3rem; align-content: start; min-height: 5.5rem; padding: 0.85rem 0.9rem; background: var(--clay); color: var(--clay-on); border-radius: var(--radius-md); }
  .hub-grid b { font-weight: 800; letter-spacing: -0.02em; }
  .hub-grid span { font-size: var(--text-xs); line-height: 1.5; }
  figcaption { margin-top: 0.6rem; font-size: var(--text-sm); color: var(--color-ink-3); }
  figcaption strong { color: var(--color-ink); }
  @media (max-width: 560px) { .hub-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
