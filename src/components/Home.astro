---
// 홈 본문. / (ko)와 /en/이 같이 쓴다.
// 맨 위는 고정된 노트북 무대(Stage.astro), 그 아래로 소개 · 업무 원칙 · 프로젝트 한눈에 보기 · 인사기록 · 연락.
// 쉬운 말 설명은 src/data/cases.ts, 기간·상태는 콘텐츠 컬렉션, 화면 문구는 i18n.ts에서 온다.
import type { ComponentProps } from 'astro/types';
import { getCollection } from 'astro:content';
import { t, EMAIL, LINKEDIN, STATUS_LABEL, type Locale } from '../i18n';
import { CASES, fileNo } from '../data/cases';
import Icon from './Icon.astro';
import Stage from './Stage.astro';

type IconName = ComponentProps<typeof Icon>['name'];
interface Props { locale: Locale; }
const { locale } = Astro.props;
const s = t[locale];
const h = s.home;
const en = locale === 'en';
const prefix = en ? '/en/' : '/';

// 프로젝트별 아이콘 ← 프로젝트를 추가하면 여기에도 한 줄
const ICONS: Record<string, IconName> = {
  'hris': 'users', 'hrga-hub': 'grid', 'meal-allowance': 'receipt', 'interview-reminder': 'mail',
  'guide-redesign': 'scale', 'asset-regulation': 'file',
};

// 쉬운 말 설명과 머리말 정보를 합친다. 하나라도 어긋나면 조용히 빠뜨리지 않고 빌드를 멈춘다.
const entries = await getCollection('projects');
const unlisted = entries.filter((e) => !CASES.some((c) => c.id === e.id)).map((e) => e.id);
if (unlisted.length) throw new Error(`Add ${unlisted.join(', ')} to src/data/cases.ts so it appears on the home page.`);
const files = CASES.map((c) => {
  const e = entries.find((p) => p.id === c.id);
  if (!e) throw new Error(`src/data/cases.ts lists "${c.id}" but src/content/projects/${c.id}.md does not exist.`);
  if (!ICONS[c.id]) throw new Error(`Home.astro has no icon for project "${c.id}". Add it to ICONS.`);
  const d = e.data;
  const copy = en ? c.en : c;
  // 기간이 "2026.03 – 운영 중", "2026.10 – 개발 중"처럼 상태로 끝나면 상태를 두 번 말하지 않는다
  const status = STATUS_LABEL[locale][d.status];
  const span = en ? d.periodEn : d.period;
  const open = span.endsWith(status);
  return {
    id: c.id,
    no: fileNo(c.id),
    short: copy.short,
    title: copy.title,
    line: copy.line,
    cat: en ? c.catEn : c.cat,
    period: open ? span.slice(0, -status.length).trimEnd() : span, // 카드: 상태 꼬리표가 옆에 따로 있다 → "2026.03 –"
    status,
    statusKey: d.status,
    caption: [en ? c.catEn : c.cat, span, ...(open ? [] : [status])].join(' · '), // 무대 아래 한 줄
    href: `${prefix}work/${c.id}/`,
    icon: ICONS[c.id],
  };
});
const record = s.hero.fields.filter(([k]) => k !== '근무지' && k !== 'Location'); // 정해 둔 항목: 소속·기간·언어·학위
const principleIcons: IconName[] = ['file', 'search', 'lock'];
---
<Stage locale={locale} files={files} />

<section id="about" class="about wrap" aria-labelledby="about-title">
  <p class="eyebrow rv">{h.aboutEyebrow}</p>
  <h2 id="about-title" class="big rv">{s.hero.statement}</h2>
  <p class="lede rv">{s.hero.sub}</p>

  <h3 class="sec-label rv">{h.principlesTitle}</h3>
  <ol class="steps">
    {h.principles.map(([head, body], i) => (
      <li class="rv" style={`--rv:${i}`}>
        <div class="step-top"><span class="tile"><Icon name={principleIcons[i]} size={20} /></span><span class="num">{i + 1}</span></div>
        <b>{head}</b>
        <p>{body}</p>
      </li>
    ))}
  </ol>
</section>

<section id="index" class="index wrap" aria-labelledby="index-title">
  <h2 id="index-title" class="sec-label rv">{h.filesTitle(files.length)}</h2>
  <ul class="cards">
    {files.map((f, i) => (
      <li class="rv" style={`--rv:${i % 2}`}>
        <a class="card" href={f.href}>
          <span class="card-top">
            <span class="tile"><Icon name={f.icon} size={18} /></span>
            <span class="no">{f.no}</span>
            <span class="status" data-status={f.statusKey}>{f.status}</span>
          </span>
          <b class="card-title">{f.title}</b>
          <span class="card-line">{f.line}</span>
          <span class="card-foot">{f.cat} · {f.period}<Icon name="arrow-right" size={16} /></span>
        </a>
      </li>
    ))}
  </ul>
</section>

<section id="record" class="record-sec wrap" aria-labelledby="record-title">
  <h2 id="record-title" class="sec-label rv">{h.recordTitle}</h2>
  <div class="who rv">
    <img class="photo" src="/juyoung.jpg" width="800" height="800" alt={h.photoAlt} loading="lazy" />
    <div class="who-body">
      <p class="who-name">{s.hero.name}<span>{s.hero.role}</span></p>
      <dl class="fields">
        {record.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>
    </div>
  </div>

  <h2 class="sec-label rv">{h.logTitle}</h2>
  <div class="acc-list">
    {s.log.entries.map(([when, head, body], i) => (
      <details class="acc rv" name="log" open={i === 0}>
        <summary><span class="when">{when}</span><b>{head}</b><Icon name="chevron-down" size={18} /></summary>
        <p>{body}</p>
      </details>
    ))}
  </div>
</section>

<section id="contact" class="contact wrap" aria-labelledby="contact-title">
  <canvas class="motif" width="560" height="200" aria-hidden="true"></canvas>
  <h2 id="contact-title" class="big rv">{h.contactTitle}</h2>
  <p class="contact-lede rv">{s.contact.lede}</p>
  <div class="contact-actions rv">
    <button type="button" class="btn" data-copy={EMAIL} data-label={h.copy} data-done={h.copied} data-fail={h.copyFailed}>{h.copy}</button>
    <a class="btn ghost" href={`mailto:${EMAIL}`}>{h.mail}</a>
    <a class="btn ghost" href={LINKEDIN} target="_blank" rel="noopener">LinkedIn<Icon name="arrow-right" size={16} /></a>
  </div>
  <p class="contact-mail rv"><a href={`mailto:${EMAIL}`}>{EMAIL}</a></p>
  <p class="copy-status" role="status"></p>
</section>

<script>
  // 이메일 복사. 실패하면 조용히 넘어가지 않고 직접 선택하라고 알려준다.
  const copyBtn = document.querySelector<HTMLButtonElement>('[data-copy]');
  const copyStatus = document.querySelector<HTMLElement>('.copy-status');
  copyBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(copyBtn.dataset.copy!);
      copyBtn.textContent = `${copyBtn.dataset.done!} ✓`;
      if (copyStatus) copyStatus.textContent = copyBtn.dataset.done!;
      setTimeout(() => { copyBtn.textContent = copyBtn.dataset.label!; if (copyStatus) copyStatus.textContent = ''; }, 2200);
    } catch {
      if (copyStatus) copyStatus.textContent = copyBtn.dataset.fail!;
    }
  });

  // 연락 구역의 그림: 흩어진 점(사람)이 줄 맞춘 격자(시스템)로 모였다가 다시 흩어진다.
  const cv = document.querySelector<HTMLCanvasElement>('.motif');
  const ctx = cv?.getContext('2d');
  if (cv && ctx) {
    const W = 560, H = 200, COLS = 14, ROWS = 5, GAP = 24; // ← 점 개수(COLS×ROWS)와 간격
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    cv.width = W * dpr; cv.height = H * dpr; ctx.scale(dpr, dpr);
    let seed = 11; // 고정된 씨앗: 새로 고쳐도 같은 자리에서 흩어진다
    const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
    const dots = Array.from({ length: COLS * ROWS }, (_, k) => ({
      sx: 14 + rnd() * (W - 28), sy: 14 + rnd() * (H - 28),
      gx: W / 2 + ((k % COLS) - (COLS - 1) / 2) * GAP, gy: H / 2 + (Math.floor(k / COLS) - (ROWS - 1) / 2) * GAP,
      ph: rnd() * Math.PI * 2,
    }));
    const ease = (x: number) => (x < 0.5 ? 4 * x * x * x : 1 - Math.pow(-2 * x + 2, 3) / 2);
    const draw = (p: number, now: number) => {
      ctx.clearRect(0, 0, W, H);
      ctx.fillStyle = getComputedStyle(cv).color;
      for (const d of dots) {
        const wob = (1 - p) * 5;
        const x = d.sx + (d.gx - d.sx) * p + Math.cos(now / 900 + d.ph) * wob;
        const y = d.sy + (d.gy - d.sy) * p + Math.sin(now / 1100 + d.ph) * wob;
        ctx.globalAlpha = 0.3 + 0.7 * p;
        ctx.beginPath(); ctx.arc(x, y, 2.2 + p * 1.4, 0, Math.PI * 2); ctx.fill();
      }
    };
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      draw(1, 0);
      new MutationObserver(() => draw(1, 0)).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    } else {
      const LOOP = 7600; // ← 한 바퀴 시간(밀리초)
      let visible = false;
      const frame = (now: number) => {
        const u = (now % LOOP) / LOOP; // 모이기 → 멈춤 → 흩어지기 → 멈춤
        draw(u < 0.34 ? ease(u / 0.34) : u < 0.62 ? 1 : u < 0.9 ? 1 - ease((u - 0.62) / 0.28) : 0, now);
        if (visible) requestAnimationFrame(frame);
      };
      new IntersectionObserver(([e]) => {
        const was = visible; visible = e.isIntersecting;
        if (visible && !was) requestAnimationFrame(frame);
      }).observe(cv);
    }
  }
</script>

<style>
  section { scroll-margin-top: var(--bar-h); }
  .tile { display: grid; place-items: center; flex: none; width: 40px; height: 40px; border-radius: 12px; background: var(--color-ink); color: var(--color-paper); }
  .big { font-size: clamp(2rem, 4.6vw, 3.6rem); line-height: 1.08; letter-spacing: -0.04em; }

  .about { padding-block: clamp(4rem, 12vh, 8rem) clamp(2rem, 6vh, 4rem); }
  .about .big { max-width: 20ch; margin-top: 0.9rem; }
  :global(html[lang="en"]) .about .big { max-width: 26ch; }
  .lede { max-width: 44rem; margin-top: 1.5rem; font-size: clamp(1.05rem, 1.6vw, 1.3rem); line-height: 1.6; color: var(--color-ink-2); }

  /* 업무 원칙: 번호가 선으로 이어진 세 단계 */
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem 1.5rem; }
  .steps li { position: relative; }
  .step-top { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.1rem; }
  .step-top::after { content: ""; flex: 1; height: 1px; margin-right: -1.5rem; background: var(--color-rule-strong); }
  .steps li:last-child .step-top::after { margin-right: 0; background: linear-gradient(to right, var(--color-rule-strong), transparent); }
  .num { display: grid; place-items: center; width: 26px; height: 26px; border-radius: 50%; border: 1px solid var(--color-rule-strong); font-size: 0.8125rem; font-weight: 600; color: var(--color-ink-2); font-variant-numeric: tabular-nums; }
  .steps b { display: block; font-size: 1.125rem; font-weight: 700; letter-spacing: -0.02em; line-height: 1.4; text-wrap: balance; }
  .steps p { margin-top: 0.5rem; color: var(--color-ink-3); line-height: 1.65; }

  /* 프로젝트 한눈에 보기 */
  .index { padding-block: clamp(2rem, 6vh, 4rem); }
  .cards { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .card { display: flex; flex-direction: column; gap: 0.6rem; height: 100%; padding: 1.4rem 1.5rem 1.2rem; border-radius: var(--radius-lg); background: var(--color-panel); border: 1px solid var(--color-rule); box-shadow: var(--shadow-card); text-decoration: none; transition: background-color var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out), transform 0.4s var(--ease-spring); }
  .card:hover { background: var(--color-accent-soft); border-color: var(--color-rule-strong); transform: translateY(-3px); }
  .card-top { display: flex; align-items: center; gap: 0.7rem; margin-bottom: 0.3rem; }
  .card-top .tile { width: 34px; height: 34px; border-radius: 10px; background: var(--color-accent-soft); color: var(--color-ink); transition: background-color var(--dur-base), color var(--dur-base); }
  .card:hover .tile { background: var(--color-ink); color: var(--color-paper); }
  .no { font-size: 0.8125rem; font-weight: 600; color: var(--color-ink-3); font-variant-numeric: tabular-nums; margin-right: auto; }
  .card-title { font-size: 1.25rem; font-weight: 700; letter-spacing: -0.025em; line-height: 1.35; text-wrap: balance; }
  .card-line { color: var(--color-ink-3); line-height: 1.6; }
  .card-foot { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; margin-top: auto; padding-top: 0.6rem; font-size: 0.8125rem; font-weight: 600; color: var(--color-ink-3); }
  .card-foot :global(svg) { transition: transform 0.4s var(--ease-spring); }
  .card:hover .card-foot :global(svg) { transform: translateX(4px); color: var(--color-ink); }

  /* 인사기록 */
  .record-sec { padding-block: clamp(2rem, 6vh, 4rem); }
  .who { display: grid; grid-template-columns: 148px minmax(0, 1fr); gap: 1.75rem; align-items: center; padding: 1.5rem; border-radius: var(--radius-lg); background: var(--color-panel); border: 1px solid var(--color-rule); box-shadow: var(--shadow-card); }
  .photo { width: 148px; height: 148px; border-radius: 18px; object-fit: cover; }
  .who-name { font-size: 1.6rem; font-weight: 700; letter-spacing: -0.03em; line-height: 1.2; }
  .who-name span { display: block; margin-top: 0.2rem; font-size: 0.9375rem; font-weight: 500; letter-spacing: 0; color: var(--color-ink-3); }
  .fields { margin: 1.1rem 0 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.9rem 1.5rem; }
  .fields dt { font-size: 0.8125rem; font-weight: 600; color: var(--color-ink-3); }
  .fields dd { margin: 0.1rem 0 0; line-height: 1.5; }

  /* 이력 로그: 하나씩 펼쳐지는 줄 */
  .acc-list { display: grid; gap: 10px; max-width: 54rem; }
  .acc { border-radius: var(--radius-md); background: var(--color-panel); border: 1px solid var(--color-rule); box-shadow: var(--shadow-card); interpolate-size: allow-keywords; transition: background-color var(--dur-base); }
  .acc:hover, .acc[open] { background: var(--color-accent-soft); }
  .acc summary { display: flex; align-items: center; gap: 1rem; min-height: 56px; padding: 0.6rem 1.2rem; cursor: pointer; list-style: none; }
  .acc summary::-webkit-details-marker { display: none; }
  .acc summary b { flex: 1; font-size: 1.0625rem; font-weight: 600; letter-spacing: -0.015em; }
  .acc summary :global(svg) { flex: none; color: var(--color-ink-3); transition: transform 0.4s var(--ease-spring); }
  .acc[open] summary :global(svg) { transform: rotate(180deg); }
  .when { flex: none; width: 4.6rem; font-size: 0.8125rem; font-weight: 600; color: var(--color-ink-3); font-variant-numeric: tabular-nums; }
  .acc p { padding: 0 1.2rem 1.1rem calc(1.2rem + 4.6rem + 1rem); color: var(--color-ink-2); line-height: 1.7; }
  .acc::details-content { block-size: 0; overflow: clip; transition: block-size 0.45s var(--ease-spring), content-visibility 0.45s allow-discrete; }
  .acc[open]::details-content { block-size: auto; }

  /* 연락 */
  .contact { display: flex; flex-direction: column; align-items: center; text-align: center; padding-block: clamp(3rem, 10vh, 6rem) clamp(4rem, 12vh, 7rem); }
  .motif { width: min(560px, 100%); height: auto; color: var(--color-ink); margin-bottom: 1rem; }
  .contact-lede { max-width: 36rem; margin-top: 1rem; color: var(--color-ink-2); }
  .contact-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin-top: 1.75rem; }
  .contact-mail { margin-top: 0.9rem; font-size: 0.875rem; font-weight: 600; color: var(--color-ink-3); }
  .contact-mail a { text-decoration: none; }
  .contact-mail a:hover { color: var(--color-ink); text-decoration: underline; }
  .copy-status { min-height: 1.5rem; margin-top: 0.4rem; font-size: 0.875rem; color: var(--color-ink-2); }

  @media (max-width: 760px) {
    .steps { grid-template-columns: 1fr; gap: 1.75rem; }
    .step-top::after { margin-right: 0; }
    .cards { grid-template-columns: 1fr; }
    .who { grid-template-columns: 1fr; gap: 1.1rem; }
    .photo { width: 112px; height: 112px; }
    .fields { grid-template-columns: 1fr; }
    .when { width: 3.9rem; }
    .acc summary { gap: 0.6rem; padding-inline: 1rem; }
    .acc p { padding: 0 1rem 1rem; }
  }
</style>
