---
// Home page body, shared by / (ko) and /en/. Case-file drawer: each project is a folder (HR-01 …) that opens
// into a sheet under the row. Plain copy comes from src/data/cases.ts, metadata from the content collection,
// UI strings from i18n.ts. Folders are real links to /work/[id]/ so the page still works without JavaScript.
import { getCollection } from 'astro:content';
import { t, EMAIL, LINKEDIN, STATUS_LABEL, type Locale } from '../i18n';
import { CASES, fileNo } from '../data/cases';
import Icon from './Icon.astro';
import HubScreen from './HubScreen.astro';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const s = t[locale];
const h = s.home;
const en = locale === 'en';
const prefix = en ? '/en/' : '/';

// Join plain copy with frontmatter. Any mismatch stops the build instead of silently dropping a file.
const entries = await getCollection('projects');
const unlisted = entries.filter((e) => !CASES.some((c) => c.id === e.id)).map((e) => e.id);
if (unlisted.length) throw new Error(`Add ${unlisted.join(', ')} to src/data/cases.ts so it appears on the home page.`);
const files = CASES.map((c, i) => {
  const e = entries.find((p) => p.id === c.id);
  if (!e) throw new Error(`src/data/cases.ts lists "${c.id}" but src/content/projects/${c.id}.md does not exist.`);
  const d = e.data;
  return {
    ...c,
    no: fileNo(c.id),
    clay: i % 5, // folder colour slot; 5 colours cycle so neighbours never match
    ...(en ? c.en : {}), // English plain copy: title, line, flow, problem, solution, result
    cat: en ? c.catEn : c.cat,
    head: en ? d.titleEn : c.name,
    period: (en ? d.periodEn : d.period).replace(/\s*(운영 중|live)$/, ''), // the status stamp already says "live"
    status: STATUS_LABEL[locale][d.status],
    live: d.status === 'live',
    href: `${prefix}work/${c.id}/`,
  };
});
const record = s.hero.fields.filter(([k]) => k !== '근무지' && k !== 'Location'); // decided set: 소속·기간·언어·학위
---
<section class="hero wrap" aria-labelledby="hero-title">
  <h1 id="hero-title" class="hero-h1">{h.h1.map((l, i) => <>{i > 0 && <br />}{l}</>)}</h1>
  {h.en && <p class="hero-en" lang="en">{h.en}</p>}
  <p class="hero-desc">{h.desc}</p>
  <div class="hero-cta">
    <a class="btn" href="#files">{h.ctaFiles}</a>
    <a class="btn ghost" href="#contact">{h.ctaContact}</a>
  </div>
</section>

<section id="files" class="files" data-mode="simple" data-view="slider" aria-labelledby="files-title">
  <div class="wrap">
    <div class="files-head">
      <div>
        <h2 id="files-title">{h.filesTitle(files.length)}</h2>
        <p>{h.filesLede}</p>
      </div>
      <div class="ctrl">
        <div class="seg" role="group" aria-label={h.amount}>
          <button type="button" data-set-mode="simple" aria-pressed="true">{h.simple}</button>
          <button type="button" data-set-mode="detail" aria-pressed="false">{h.detail}</button>
        </div>
        <div class="seg" role="group" aria-label={h.view}>
          <button type="button" data-set-view="slider" aria-pressed="true">{h.slider}</button>
          <button type="button" data-set-view="list" aria-pressed="false">{h.list}</button>
        </div>
        <div class="arrows">
          <button type="button" data-dir="-1" aria-label={h.prev}><Icon name="arrow-left" /></button>
          <button type="button" data-dir="1" aria-label={h.next}><Icon name="arrow-right" /></button>
        </div>
      </div>
    </div>

    <ol class="drawer">
      {files.map((f) => (
        <li class="folder" data-clay={f.clay} data-file={f.id}>
          <a class="folder-btn" href={f.href} aria-controls={`sheet-${f.id}`}>
            <span class="tab">{f.no}</span>
            <span class="face">
              <span class="ftitle">{f.title}</span>
              <span class="fline">{f.line}</span>
              <span class="foot"><span class="period">{f.cat} · {f.period}</span><span class:list={['pill', { live: f.live }]}>{f.status}</span></span>
            </span>
          </a>
        </li>
      ))}
    </ol>

    <!-- One sheet per file; the script shows one at a time and moves it under its folder (list view) or the drawer (slider view). -->
    <div class="sheets">
      {files.map((f) => (
        <article class="sheet" id={`sheet-${f.id}`} data-clay={f.clay} aria-labelledby={`sheet-${f.id}-title`} hidden>
          <header class="sheet-head">
            <span><b>{f.no}</b> · {f.head}</span>
            <button type="button" class="sheet-close" aria-label={h.close}><Icon name="close" /></button>
          </header>
          <div class="sheet-trow">
            <h3 id={`sheet-${f.id}-title`} tabindex="-1">{f.title}</h3>
            <span class="stamp">{f.status}</span>
          </div>
          <p class="sheet-meta">{f.cat} · {f.period}</p>
          <p class="sheet-line">{f.line}</p>
          <ol class="flow" aria-label={h.flow}>
            {f.flow.map((x, i) => <li><b>{['IN', 'DO', 'OUT'][i]}</b><span>{x}</span></li>)}
          </ol>
          <button type="button" class="more-btn" aria-expanded="false" aria-controls={`more-${f.id}`}>
            <span class="when-closed">{h.more}</span><span class="when-open">{h.less}</span><Icon name="chevron-down" />
          </button>
          <div class="more" id={`more-${f.id}`}>
            <div>
              <dl class="psr">
                <div><dt>{h.psr[0]}</dt><dd>{f.problem}</dd></div>
                <div><dt>{h.psr[1]}</dt><dd>{f.solution}</dd></div>
                <div><dt>{h.psr[2]}</dt><dd>{f.result}</dd></div>
              </dl>
              {f.id === 'hrga-hub' && <HubScreen locale={locale} />}
            </div>
          </div>
          <a class="full" href={f.href}>{h.full}<Icon name="arrow-right" size={18} /></a>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="principles wrap" aria-labelledby="principles-title">
  <div class="memo">
    <h2 id="principles-title">{h.principlesTitle}</h2>
    <ol>
      {h.principles.map(([head, body]) => <li><b>{head}</b><span>{body}</span></li>)}
    </ol>
  </div>
</section>

<section id="record" class="record-sec wrap" aria-labelledby="record-title">
  <h2 id="record-title">{h.recordTitle}</h2>
  <div class="card">
    <img class="photo" src="/juyoung.jpg" width="800" height="800" alt={h.photoAlt} loading="lazy" />
    <div class="who">
      <p class="who-name">{s.hero.name}<span>{s.hero.role}</span></p>
      <p class="who-sub">{s.hero.sub}</p>
      <dl class="fields">
        {record.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>
    </div>
    <div class="log">
      <h3>{h.logTitle}</h3>
      <ol>
        {s.log.entries.map(([when, head, body]) => (
          <li><span class="when">{when}</span><b>{head}</b><span class="what">{body}</span></li>
        ))}
      </ol>
    </div>
  </div>
</section>

<section id="contact" class="contact wrap" aria-labelledby="contact-title">
  <h2 id="contact-title">{h.contactTitle}</h2>
  <p class="contact-lede">{s.contact.lede}</p>
  <div class="contact-card">
    <a class="mail" href={`mailto:${EMAIL}`}>{EMAIL}</a>
    <div class="contact-actions">
      <button type="button" class="btn" data-copy={EMAIL} data-done={h.copied} data-fail={h.copyFailed}>{h.copy}</button>
      <a class="btn ghost" href={LINKEDIN} target="_blank" rel="noopener">LinkedIn<Icon name="arrow-right" size={18} /></a>
    </div>
    <p class="copy-status" role="status"></p>
  </div>
</section>

<script>
  const root = document.getElementById('files');
  if (root) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const drawer = root.querySelector<HTMLElement>('.drawer')!;
    const sheets = root.querySelector<HTMLElement>('.sheets')!;
    const links = [...root.querySelectorAll<HTMLAnchorElement>('.folder-btn')];
    let openId: string | null = null;

    // folders are links (no-JS fallback); with JS they act as disclosure buttons
    links.forEach((a) => { a.setAttribute('role', 'button'); a.setAttribute('aria-expanded', 'false'); });
    const idOf = (a: Element) => a.closest<HTMLElement>('.folder')!.dataset.file!;
    const sheetOf = (id: string) => document.getElementById(`sheet-${id}`)!;
    const folderOf = (id: string) => drawer.querySelector<HTMLElement>(`.folder[data-file="${id}"]`)!;

    function setMore(sheet: HTMLElement, on: boolean) {
      sheet.classList.toggle('open', on);
      sheet.querySelector('.more-btn')?.setAttribute('aria-expanded', String(on));
    }
    function place(sheet: HTMLElement, id: string) {
      // list view: the sheet sits under its own row; slider view: under the whole drawer
      if (root!.dataset.view === 'list') folderOf(id).append(sheet); else sheets.append(sheet);
    }
    function mark(id: string | null) {
      openId = id;
      links.forEach((a) => {
        const on = idOf(a) === id;
        a.setAttribute('aria-expanded', String(on));
        a.parentElement!.classList.toggle('on', on);
      });
    }
    function close(returnFocus: boolean) {
      if (!openId) return;
      const id = openId;
      const sheet = sheetOf(id);
      sheet.hidden = true;
      sheets.append(sheet);
      mark(null);
      if (returnFocus) folderOf(id).querySelector<HTMLElement>('.folder-btn')!.focus();
    }
    function open(id: string) {
      if (openId === id) { close(true); return; }
      close(false);
      const sheet = sheetOf(id);
      place(sheet, id);
      sheet.hidden = false;
      setMore(sheet, root!.dataset.mode === 'detail');
      sheet.classList.remove('anim');
      void sheet.offsetWidth; // restart the pull-out animation
      sheet.classList.add('anim');
      mark(id);
      sheet.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'nearest' });
      sheet.querySelector<HTMLElement>('h3')!.focus({ preventScroll: true });
    }

    root.addEventListener('click', (e) => {
      const ev = e as MouseEvent;
      const target = ev.target as Element;
      const folder = target.closest('.folder-btn');
      if (folder) {
        if (ev.metaKey || ev.ctrlKey || ev.shiftKey || ev.button !== 0) return; // let "open in new tab" work
        e.preventDefault();
        open(idOf(folder));
        return;
      }
      if (target.closest('.sheet-close')) { close(true); return; }
      const more = target.closest('.more-btn');
      if (more) { const sheet = more.closest<HTMLElement>('.sheet')!; setMore(sheet, !sheet.classList.contains('open')); return; }
      const mode = target.closest<HTMLElement>('[data-set-mode]');
      if (mode) {
        root.dataset.mode = mode.dataset.setMode;
        root.querySelectorAll('[data-set-mode]').forEach((b) => b.setAttribute('aria-pressed', String(b === mode)));
        if (openId) setMore(sheetOf(openId), root.dataset.mode === 'detail');
        return;
      }
      const view = target.closest<HTMLElement>('[data-set-view]');
      if (view) {
        root.dataset.view = view.dataset.setView;
        root.querySelectorAll('[data-set-view]').forEach((b) => b.setAttribute('aria-pressed', String(b === view)));
        if (openId) place(sheetOf(openId), openId);
        return;
      }
      const arrow = target.closest<HTMLElement>('[data-dir]');
      if (arrow) {
        const step = drawer.querySelector('.folder')!.getBoundingClientRect().width + 24;
        drawer.scrollBy({ left: Number(arrow.dataset.dir) * step, behavior: reduce ? 'auto' : 'smooth' });
      }
    });
    root.addEventListener('keydown', (e) => {
      const target = e.target as Element;
      if (e.key === ' ' && target.matches('.folder-btn')) { e.preventDefault(); open(idOf(target)); }
      if (e.key === 'Escape' && openId) close(true);
    });
  }

  // copy email; on failure say so instead of pretending it worked
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => {
    const label = b.textContent;
    const status = b.closest('.contact-card')?.querySelector('.copy-status');
    b.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(b.dataset.copy!);
        b.textContent = b.dataset.done!;
        if (status) status.textContent = '';
        setTimeout(() => { b.textContent = label; }, 1800);
      } catch {
        if (status) status.textContent = b.dataset.fail!;
      }
    });
  });
</script>

<style>
  /* keep anchor targets and opened sheets clear of the sticky top bar */
  section[id], .sheet { scroll-margin-top: 76px; }

  /* ── hero ─────────────────────────────────────────── */
  .hero { padding-block: clamp(2.5rem, 6vw, 5.5rem) clamp(1.5rem, 3vw, 2.5rem); }
  .hero-h1 { font-size: clamp(2.6rem, 6.4vw, 5.75rem); line-height: 1.08; max-width: 12em; }
  .hero-en { margin-top: 1rem; font-size: clamp(1.15rem, 2vw, 1.5rem); font-weight: 600; letter-spacing: -0.02em; color: var(--color-ink-3); }
  .hero-desc { margin-top: 1.25rem; font-size: clamp(1.05rem, 1.4vw, 1.2rem); line-height: 1.75; max-width: 34em; }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 1.75rem; }

  /* ── files: head + controls ───────────────────────── */
  .files { padding-block: clamp(1rem, 2vw, 1.5rem) clamp(1.5rem, 3vw, 2.5rem); }
  .files-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 1rem 1.5rem; }
  .files-head h2 { font-size: clamp(1.9rem, 3.4vw, 2.75rem); }
  .files-head p { margin-top: 0.3rem; color: var(--color-ink-3); }
  .ctrl { display: flex; flex-wrap: wrap; gap: 0.6rem; align-items: center; }
  .seg { display: inline-flex; border: 1.5px solid var(--color-ink); border-radius: var(--radius-sm); overflow: hidden; }
  .seg button { min-height: 44px; border: 0; background: transparent; padding: 0 1rem; font: inherit; font-weight: 700; font-size: var(--text-sm); color: var(--color-ink); cursor: pointer; transition: background var(--dur-base) var(--ease-out), color var(--dur-base) var(--ease-out); }
  .seg button:hover { background: var(--color-paper-3); }
  .seg button[aria-pressed="true"] { background: var(--color-ink); color: var(--color-paper); }
  .seg button:focus-visible { outline-offset: -4px; }
  .arrows { display: flex; gap: 0.4rem; }
  .arrows button { display: grid; place-items: center; width: 44px; height: 44px; border: 1.5px solid var(--color-ink); border-radius: var(--radius-sm); background: transparent; color: var(--color-ink); cursor: pointer; }
  .arrows button:hover { background: var(--color-ink); color: var(--color-paper); }
  .files[data-view="list"] .arrows { display: none; }

  /* ── drawer: slider view (default) ────────────────── */
  /* the strip bleeds to both viewport edges while the first folder stays aligned with the text column */
  .drawer {
    --bleed: max(clamp(1rem, 4vw, 2.5rem), calc((100vw - var(--page-max)) / 2 + clamp(1rem, 4vw, 2.5rem))); /* = .wrap's left inset; no % so scroll-padding means the same */
    list-style: none; margin: 0 calc(-1 * var(--bleed)); padding: 2rem var(--bleed) 2.25rem;
    display: flex; gap: 1.5rem; overflow-x: auto; scroll-snap-type: x mandatory; overscroll-behavior-x: contain;
    scroll-padding-inline: var(--bleed); scrollbar-width: thin; scrollbar-color: var(--color-rule-strong) transparent;
  }
  .folder { flex: 0 0 clamp(16rem, 24vw, 18.5rem); scroll-snap-align: start; }
  .folder-btn {
    position: relative; display: block; height: 100%; padding-top: 2.1rem; color: var(--clay-on); text-decoration: none;
    transition: transform 400ms var(--ease-out);
  }
  .folder-btn:hover, .folder.on .folder-btn { transform: translateY(-10px); }
  .folder-btn:focus-visible { outline: none; }
  .folder-btn:focus-visible .face { outline: 3px solid var(--color-stamp); outline-offset: 4px; }
  .tab {
    position: absolute; top: 0; left: 1.1rem; height: 2.25rem; padding: 0 0.9rem; display: flex; align-items: center;
    background: var(--color-ink); color: #fff; font-weight: 800; font-size: var(--text-sm); letter-spacing: 0.02em;
    border-radius: var(--radius-sm) var(--radius-sm) 0 0; font-variant-numeric: tabular-nums;
  }
  .face {
    display: flex; flex-direction: column; gap: 0.75rem; height: 100%; min-height: 15rem; padding: 1.4rem 1.25rem 1.1rem;
    background: var(--clay); border-radius: 6px var(--radius-lg) var(--radius-lg) var(--radius-lg);
    box-shadow: 0 18px 36px -24px rgba(10, 10, 10, 0.45);
  }
  .folder.on .face { outline: 3px solid var(--color-ink); outline-offset: 4px; }
  .ftitle { font-size: 1.5rem; font-weight: 800; line-height: 1.28; letter-spacing: -0.04em; text-wrap: balance; }
  .fline { font-size: 0.95rem; line-height: 1.65; display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; }
  .files[data-mode="detail"] .fline { -webkit-line-clamp: 9; }
  .files[data-mode="detail"] .face { min-height: 21rem; }
  .foot { margin-top: auto; display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; font-size: var(--text-sm); font-variant-numeric: tabular-nums; }
  .pill { border: 1.5px solid currentColor; padding: 0.1rem 0.6rem; border-radius: 999px; font-weight: 700; font-size: var(--text-xs); white-space: nowrap; }

  /* ── drawer: list view (same markup, re-laid as rows) ── */
  .files[data-view="list"] .drawer { display: grid; gap: 0.75rem; overflow: visible; padding: 1.5rem 0 0; margin: 0; }
  .files[data-view="list"] .folder-btn {
    display: grid; grid-template-columns: auto minmax(0, 1fr) auto; column-gap: 1rem; align-items: center;
    padding: 1rem 1.25rem; background: var(--clay); border-radius: var(--radius-md); height: auto;
  }
  .files[data-view="list"] .folder-btn:hover, .files[data-view="list"] .folder.on .folder-btn { transform: translateX(6px); }
  .files[data-view="list"] .folder.on .folder-btn { outline: 3px solid var(--color-ink); outline-offset: 3px; }
  .files[data-view="list"] .folder-btn:focus-visible { outline: 3px solid var(--color-stamp); outline-offset: 3px; }
  .files[data-view="list"] .face { display: contents; min-height: 0; }
  .files[data-view="list"] .folder.on .face, .files[data-view="list"] .folder-btn:focus-visible .face { outline: none; }
  .files[data-view="list"] .tab { position: static; grid-column: 1; grid-row: 1 / span 3; align-self: start; height: auto; padding: 0.3rem 0.7rem; border-radius: 999px; }
  .files[data-view="list"] .ftitle { grid-column: 2; grid-row: 1; font-size: 1.2rem; }
  .files[data-view="list"] .period { grid-column: 2; grid-row: 2; }
  .files[data-view="list"] .fline { display: none; grid-column: 2; grid-row: 3; margin-top: 0.4rem; -webkit-line-clamp: unset; }
  .files[data-view="list"][data-mode="detail"] .fline { display: block; }
  .files[data-view="list"] .foot { display: contents; }
  .files[data-view="list"] .pill { grid-column: 3; grid-row: 1 / span 2; }
  .files[data-view="list"] .sheet { margin-top: 0.75rem; }

  /* ── sheet ────────────────────────────────────────── */
  .sheet {
    position: relative; margin: 0.5rem 0 0; padding: clamp(1.4rem, 3vw, 2.5rem);
    background: var(--color-paper-2); color: var(--color-ink); border-radius: var(--radius-lg);
    box-shadow: inset 0 8px 0 var(--clay), var(--shadow-sheet); /* top edge in its folder's colour: shows which file it came out of */
  }
  .sheet.anim { animation: pull 550ms var(--ease-out); }
  @keyframes pull { from { transform: translateY(28px); opacity: 0; } to { transform: none; opacity: 1; } }
  .sheet-head { display: flex; justify-content: space-between; align-items: center; gap: 0.75rem; padding-bottom: 0.75rem; border-bottom: 1.5px solid var(--color-ink); font-size: var(--text-sm); }
  .sheet-head b { display: inline-block; padding: 0.15rem 0.6rem; border-radius: 999px; background: var(--clay); color: var(--clay-on); font-variant-numeric: tabular-nums; }
  .sheet-close { display: grid; place-items: center; width: 44px; height: 44px; border: 1.5px solid var(--color-ink); border-radius: var(--radius-sm); background: transparent; color: var(--color-ink); cursor: pointer; }
  .sheet-close:hover { background: var(--color-ink); color: var(--color-paper); }
  .sheet-trow { display: flex; justify-content: space-between; align-items: flex-start; gap: 0.75rem 1.5rem; margin-top: 1.4rem; }
  .sheet h3 { font-size: clamp(1.6rem, 3.2vw, 2.4rem); line-height: 1.22; letter-spacing: -0.04em; }
  .sheet h3:focus { outline: none; }
  .stamp {
    flex: none; margin-top: 0.25rem; padding: 0.35rem 0.9rem; border: 3px solid var(--color-stamp); border-radius: var(--radius-sm);
    color: var(--color-stamp); font-weight: 800; font-size: 1.1rem; white-space: nowrap; transform: rotate(-8deg); mix-blend-mode: multiply;
  }
  .sheet.anim .stamp { animation: stamp 500ms 300ms cubic-bezier(0.2, 1.5, 0.4, 1) both; }
  @keyframes stamp { from { transform: rotate(-8deg) scale(1.7); opacity: 0; } to { transform: rotate(-8deg) scale(1); opacity: 1; } }
  .sheet-meta { margin-top: 0.5rem; font-size: var(--text-sm); color: var(--color-ink-3); }
  .sheet-line { margin-top: 1rem; font-size: 1.075rem; line-height: 1.75; max-width: 40em; }
  .flow { list-style: none; margin: 1.25rem 0 0; padding: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; font-size: var(--text-sm); }
  .flow li { display: flex; align-items: center; gap: 0.5rem; }
  .flow li + li::before { content: ""; width: 1.1rem; height: 1.5px; background: var(--color-ink); }
  .flow b { flex: none; padding: 0.1rem 0.55rem; border-radius: 999px; background: var(--color-ink); color: var(--color-paper); font-size: var(--text-xs); letter-spacing: 0.04em; }
  .more-btn {
    display: inline-flex; align-items: center; gap: 0.5rem; margin-top: 1.4rem; min-height: 44px; padding: 0 1rem;
    border: 0; border-radius: var(--radius-sm); background: var(--color-ink); color: var(--color-paper); font: inherit; font-weight: 700; font-size: 0.95rem; cursor: pointer;
  }
  .more-btn:hover { background: var(--color-stamp); }
  .more-btn :global(svg) { transition: transform 350ms var(--ease-out); }
  .sheet.open .more-btn :global(svg) { transform: rotate(180deg); }
  .when-open, .sheet.open .when-closed { display: none; }
  .sheet.open .when-open { display: inline; }
