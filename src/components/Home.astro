---
// 홈 본문. / (ko)와 /en/이 같이 쓴다.
// 맨 위는 노트북 무대(Stage.astro), 그 아래로 소개 · 업무 원칙 · 프로젝트 목록 · 인사기록 · 경력 · 연락.
// 프로젝트 이름은 src/data/cases.ts, 상태는 콘텐츠 컬렉션, 화면 문구는 i18n.ts에서 온다.
// 2026-11-19 "복잡하다, 글이 많다"는 피드백으로 홈에는 한 줄짜리만 둔다. 긴 설명은 각 프로젝트 상세 페이지에 있다.
import type { ComponentProps } from 'astro/types';
import { getCollection } from 'astro:content';
import { t, EMAIL, LINKEDIN, STATUS_LABEL, type Locale } from '../i18n';
import { CASES } from '../data/cases';
import Icon from './Icon.astro';
import Stage from './Stage.astro';

type IconName = ComponentProps<typeof Icon>['name'];
interface Props { locale: Locale; }
const { locale } = Astro.props;
const s = t[locale];
const h = s.home;
const en = locale === 'en';
const prefix = en ? '/en/' : '/';

// 경력: 회사별 묶음을 최신 회사부터, 묶음 안에서도 최신 일부터 보여 준다 (i18n.ts에는 오래된 순으로 적혀 있다)
const jobs = [...s.log.jobs].reverse().map((j) => {
  if (!j.items?.length && !j.body) throw new Error(`Home.astro: log job "${j.org}" in src/i18n.ts has neither body nor items.`);
  return { ...j, items: j.items?.length ? [...j.items].reverse() : null };
});

// 프로젝트별 아이콘 ← 프로젝트를 추가하면 여기에도 한 줄
const ICONS: Record<string, IconName> = {
  'hris': 'users', 'hrga-hub': 'grid', 'meal-allowance': 'receipt', 'interview-reminder': 'mail',
  'guide-redesign': 'scale', 'asset-regulation': 'file',
};

// 연락 구역 점 그림: 흩어진 점이 모여 이 글자가 된다. 글꼴에 없는 글자거나 캔버스보다 넓으면 빌드를 멈춘다.
const MOTIF_TEXT = 'JUYOUNG YOU'; // ← 점으로 쓸 글자 (아래 DOT_FONT에 있는 대문자와 빈칸만)
const MOTIF = { w: 560, h: 200, pitch: 9 }; // ← 캔버스 크기와 점 사이 간격(px)
// 가로 5 × 세로 7칸 점 글꼴. 1 = 점이 놓이는 자리 ← 다른 글자를 쓰려면 여기에 추가
const DOT_FONT: Record<string, string[]> = {
  J: ['00111', '00010', '00010', '00010', '00010', '10010', '01100'],
  U: ['10001', '10001', '10001', '10001', '10001', '10001', '01110'],
  Y: ['10001', '10001', '01010', '00100', '00100', '00100', '00100'],
  O: ['01110', '10001', '10001', '10001', '10001', '10001', '01110'],
  N: ['10001', '10001', '11001', '10101', '10011', '10001', '10001'],
  G: ['01110', '10001', '10000', '10111', '10001', '10001', '01110'],
};
const motifCells: [number, number][] = [];
let motifCol = 0;
for (const ch of MOTIF_TEXT) {
  if (ch === ' ') { motifCol += 2; continue; } // 낱말 사이는 글자 사이(1칸)보다 2칸 더 띈다
  const glyph = DOT_FONT[ch];
  if (!glyph) throw new Error(`Home.astro: MOTIF_TEXT contains "${ch}", which DOT_FONT does not define. Add its 5x7 pattern or change the text.`);
  glyph.forEach((row, r) => [...row].forEach((v, c) => { if (v === '1') motifCells.push([motifCol + c, r]); }));
  motifCol += 6;
}
const motifSpan = (motifCol - 2) * MOTIF.pitch;
if (!motifCells.length) throw new Error('Home.astro: MOTIF_TEXT is empty, so the contact motif has no dots to draw.');
if (motifSpan > MOTIF.w - 12) throw new Error(`Home.astro: "${MOTIF_TEXT}" needs ${motifSpan}px but the motif canvas allows ${MOTIF.w - 12}px. Shorten the text or lower MOTIF.pitch.`);
const motifDots = motifCells
  .map(([c, r]) => `${(MOTIF.w - motifSpan) / 2 + c * MOTIF.pitch},${(MOTIF.h - 6 * MOTIF.pitch) / 2 + r * MOTIF.pitch}`)
  .join(' ');

// 쉬운 말 설명과 머리말 정보를 합친다. 하나라도 어긋나면 조용히 빠뜨리지 않고 빌드를 멈춘다.
const entries = await getCollection('projects');
const unlisted = entries.filter((e) => !CASES.some((c) => c.id === e.id)).map((e) => e.id);
if (unlisted.length) throw new Error(`Add ${unlisted.join(', ')} to src/data/cases.ts so it appears on the home page.`);
const files = CASES.map((c) => {
  const e = entries.find((p) => p.id === c.id);
  if (!e) throw new Error(`src/data/cases.ts lists "${c.id}" but src/content/projects/${c.id}.md does not exist.`);
  if (!ICONS[c.id]) throw new Error(`Home.astro has no icon for project "${c.id}". Add it to ICONS.`);
  const copy = en ? c.en : c;
  return {
    id: c.id,
    short: copy.short,
    title: copy.title,
    status: STATUS_LABEL[locale][e.data.status],
    statusKey: e.data.status,
    href: `${prefix}work/${c.id}/`,
    icon: ICONS[c.id],
  };
});
const record = s.hero.fields.filter(([k]) => k !== '근무지' && k !== 'Location'); // 정해 둔 항목: 소속·기간·언어·학위
---
<Stage locale={locale} files={files} />

<section id="about" class="about wrap" aria-labelledby="about-title">
  <p class="eyebrow rv">{h.aboutEyebrow}</p>
  <h2 id="about-title" class="big rv">{s.hero.statement}</h2>
  <dl class="stats">
    {h.stats.map(([n, label], i) => <div class="rv" style={`--rv:${i}`}><dt>{label}</dt><dd>{n}</dd></div>)}
  </dl>

  <h3 class="sec-label rv">{h.principlesTitle}</h3>
  <ol class="steps">
    {h.principles.map((head, i) => <li class="rv" style={`--rv:${i}`}><span class="num">{i + 1}</span><b>{head}</b></li>)}
  </ol>
</section>

{/* 메뉴의 "작업 파일"이 여기로 온다 */}
<section id="files" class="index wrap" aria-labelledby="index-title">
  <h2 id="index-title" class="sec-label rv">{h.filesTitle(files.length)}</h2>
  <ul class="rows">
    {files.map((f) => (
      <li class="rv">
        <a class="row" href={f.href}>
          <span class="tile"><Icon name={f.icon} size={18} /></span>
          <span class="row-txt"><b>{f.short}</b><span>{f.title}</span></span>
          <span class="status" data-status={f.statusKey}>{f.status}</span>
          <Icon name="arrow-right" size={16} />
        </a>
      </li>
    ))}
  </ul>
</section>

<section id="record" class="record-sec wrap" aria-labelledby="record-title">
  <h2 id="record-title" class="sec-label rv">{h.recordTitle}</h2>
  <div class="who rv">
    <img class="photo" src="/juyoung.jpg" width="800" height="800" alt={h.photoAlt} loading="lazy" />
    <div class="who-body">
      <p class="who-name">{s.hero.name}<span>{s.hero.role}</span></p>
      <dl class="fields">
        {record.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>
    </div>
  </div>

  {/* 경력: 회사마다 한 묶음. 줄을 누르면 설명이 펼쳐진다. 줄끼리 서로 닫지 않는다: 위쪽 줄이 닫히면 누른 줄이 손가락 밑에서 달아난다 */}
  <h2 class="sec-label rv">{h.logTitle}</h2>
  <div class="jobs">
    {jobs.map((j) => j.items ? (
      <article class="job rv">
        <header class="job-head"><h3>{j.org}<span>{j.role}</span></h3><span class="period">{j.period}</span></header>
        {j.items.map(([when, head, body]) => (
          <details class="acc">
            <summary><span class="when">{when}</span><b>{head}</b><Icon name="chevron-down" size={18} /></summary>
            <p>{body}</p>
          </details>
        ))}
      </article>
    ) : (
      <details class="job acc rv">
        <summary class="job-head"><h3>{j.org}<span>{j.role}</span></h3><span class="period">{j.period}</span><Icon name="chevron-down" size={18} /></summary>
        <p>{j.body}</p>
      </details>
    ))}
  </div>
</section>

<section id="contact" class="contact wrap" aria-labelledby="contact-title">
  <canvas class="motif" width={MOTIF.w} height={MOTIF.h} data-dots={motifDots} aria-hidden="true"></canvas>
  <h2 id="contact-title" class="big rv">{h.contactTitle}</h2>
  <p class="contact-lede rv">{s.contact.lede}</p>
  <div class="contact-actions rv">
    <button type="button" class="btn" data-copy={EMAIL} data-label={h.copy} data-done={h.copied} data-fail={h.copyFailed}>{h.copy}</button>
    <a class="btn ghost" href={LINKEDIN} target="_blank" rel="noopener">LinkedIn<Icon name="arrow-right" size={16} /></a>
  </div>
  <p class="contact-mail rv"><a href={`mailto:${EMAIL}`}>{EMAIL}</a></p>
  <p class="copy-status" role="status"></p>
</section>

<script>
  // 이메일 복사. 실패하면 조용히 넘어가지 않고 직접 선택하라고 알려준다.
  const copyBtn = document.querySelector<HTMLButtonElement>('[data-copy]');
  const copyStatus = document.querySelector<HTMLElement>('.copy-status');
  copyBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(copyBtn.dataset.copy!);
      copyBtn.textContent = `${copyBtn.dataset.done!} ✓`;
      if (copyStatus) copyStatus.textContent = copyBtn.dataset.done!;
      setTimeout(() => { copyBtn.textContent = copyBtn.dataset.label!; if (copyStatus) copyStatus.textContent = ''; }, 2200);
    } catch {
      if (copyStatus) copyStatus.textContent = copyBtn.dataset.fail!;
    }
  });

  // 연락 구역의 그림: 흩어진 점(사람)이 모여 이름이 됐다가 다시 흩어진다.
  // 글자·크기·간격은 이 파일 맨 위의 MOTIF_TEXT / MOTIF에서 정하고, 점 자리는 태그의 data-dots로 넘어온다.
  const cv = document.querySelector<HTMLCanvasElement>('.motif');
  const ctx = cv?.getContext('2d');
  if (cv && ctx) {
    const W = cv.width, H = cv.height;
    const R = 3; // ← 다 모였을 때 점 반지름(px)
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    cv.width = W * dpr; cv.height = H * dpr; ctx.scale(dpr, dpr);
    let seed = 11; // 고정된 씨앗: 새로 고쳐도 같은 자리에서 흩어진다
    const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
    const dots = cv.dataset.dots!.split(' ').map((s) => {
      const [gx, gy] = s.split(',').map(Number);
      return { sx: 14 + rnd() * (W - 28), sy: 14 + rnd() * (H - 28), gx, gy, ph: rnd() * Math.PI * 2 };
    });
    const ease = (x: number) => (x < 0.5 ? 4 * x * x * x : 1 - Math.pow(-2 * x + 2, 3) / 2);
    const draw = (p: number, now: number) => {
      ctx.clearRect(0, 0, W, H);
      ctx.fillStyle = getComputedStyle(cv).color;
      ctx.globalAlpha = 0.3 + 0.7 * p;
      const wob = (1 - p) * 5, r = 2.2 + p * (R - 2.2);
      for (const d of dots) {
        const x = d.sx + (d.gx - d.sx) * p + Math.cos(now / 900 + d.ph) * wob;
        const y = d.sy + (d.gy - d.sy) * p + Math.sin(now / 1100 + d.ph) * wob;
        ctx.beginPath(); ctx.arc(x, y, r, 0, Math.PI * 2); ctx.fill();
      }
    };
    const still = () => draw(1, 0);
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      still();
      new MutationObserver(still).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    } else {
      const LOOP = 7600; // ← 한 바퀴 시간(밀리초)
      let visible = false, t0 = 0, raf = 0;
      const frame = (now: number) => {
        const t = Math.max(0, now - t0); // 화면에 들어온 순간부터 센다: 늘 흩어진 상태에서 시작해 모인다
        const u = (t % LOOP) / LOOP; // 모이기 → 멈춤 → 흩어지기 → 멈춤
        draw(u < 0.34 ? ease(u / 0.34) : u < 0.62 ? 1 : u < 0.9 ? 1 - ease((u - 0.62) / 0.28) : 0, now);
        if (visible) raf = requestAnimationFrame(frame);
      };
      new IntersectionObserver(([e]) => {
        const was = visible; visible = e.isIntersecting;
        // 예약된 프레임을 지우고 새로 시작한다: 빠르게 들락거려도 그리기가 두 겹으로 돌지 않는다
        if (visible && !was) { t0 = performance.now(); cancelAnimationFrame(raf); raf = requestAnimationFrame(frame); }
      }).observe(cv);
    }
  }
</script>

<style>
  section { scroll-margin-top: var(--bar-h); }
  .tile { display: grid; place-items: center; flex: none; width: 40px; height: 40px; border-radius: 12px; background: var(--color-ink); color: var(--color-paper); }
  .big { font-size: clamp(2rem, 4.6vw, 3.6rem); line-height: 1.08; letter-spacing: -0.04em; }

  .about { padding-block: clamp(4rem, 12vh, 8rem) clamp(2rem, 6vh, 4rem); }
  .about .big { max-width: 20ch; margin-top: 0.9rem; }
  :global(html[lang="en"]) .about .big { max-width: 26ch; }

  /* 숫자 세 개: 큰 숫자 위, 설명 아래 */
  .stats { margin: clamp(2rem, 5vh, 3rem) 0 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; max-width: 46rem; }
  .stats div { display: flex; flex-direction: column-reverse; gap: 0.2rem; padding-top: 1rem; border-top: 1px solid var(--color-rule-strong); }
  .stats dd { margin: 0; font-size: clamp(1.7rem, 3.6vw, 2.6rem); font-weight: 700; letter-spacing: -0.04em; line-height: 1.1; font-variant-numeric: tabular-nums; }
  .stats dt { font-size: 0.9375rem; color: var(--color-ink-3); line-height: 1.4; }

  /* 업무 원칙: 번호 + 한 줄 */
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem 1.5rem; }
  .steps li { display: flex; align-items: flex-start; gap: 0.75rem; }
  .num { display: grid; place-items: center; flex: none; width: 26px; height: 26px; border-radius: 50%; border: 1px solid var(--color-rule-strong); font-size: 0.8125rem; font-weight: 600; color: var(--color-ink-2); font-variant-numeric: tabular-nums; }
  .steps b { font-size: 1.0625rem; font-weight: 600; letter-spacing: -0.02em; line-height: 1.45; text-wrap: balance; }

  /* 프로젝트 목록: 한 줄에 하나 */
  .index { padding-block: clamp(2rem, 6vh, 4rem); }
  .rows { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .row { display: flex; align-items: center; gap: 0.9rem; min-height: 64px; padding: 0.7rem 1.2rem; border-radius: var(--radius-md); background: var(--color-panel); border: 1px solid var(--color-rule); box-shadow: var(--shadow-card); text-decoration: none; transition: background-color var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out); }
  .row:hover { background: var(--color-accent-soft); border-color: var(--color-rule-strong); }
  .row .tile { width: 34px; height: 34px; border-radius: 10px; background: var(--color-accent-soft); color: var(--color-ink); transition: background-color var(--dur-base), color var(--dur-base); }
  .row:hover .tile { background: var(--color-ink); color: var(--color-paper); }
  .row-txt { flex: 1; min-width: 0; display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.1rem 0.8rem; }
  .row-txt b { font-size: 1.0625rem; font-weight: 700; letter-spacing: -0.02em; }
  .row-txt span { color: var(--color-ink-3); line-height: 1.45; }
  .row .status { flex: none; }
  .row > :global(svg) { flex: none; color: var(--color-ink-3); transition: transform 0.4s var(--ease-spring); }
  .row:hover > :global(svg) { transform: translateX(4px); color: var(--color-ink); }

  /* 인사기록 */
  .record-sec { padding-block: clamp(2rem, 6vh, 4rem); }
  .who { display: grid; grid-template-columns: 148px minmax(0, 1fr); gap: 1.75rem; align-items: center; padding: 1.5rem; border-radius: var(--radius-lg); background: var(--color-panel); border: 1px solid var(--color-rule); box-shadow: var(--shadow-card); }
  .photo { width: 148px; height: 148px; border-radius: 18px; object-fit: cover; }
  .who-name { font-size: 1.6rem; font-weight: 700; letter-spacing: -0.03em; line-height: 1.2; }
  .who-name span { display: block; margin-top: 0.2rem; font-size: 0.9375rem; font-weight: 500; letter-spacing: 0; color: var(--color-ink-3); }
  .fields { margin: 1.1rem 0 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.9rem 1.5rem; }
  .fields dt { font-size: 0.8125rem; font-weight: 600; color: var(--color-ink-3); }
  .fields dd { margin: 0.1rem 0 0; line-height: 1.5; }

  /* 경력: 회사마다 카드 하나. 카드 머리 = 회사 · 직무 · 기간, 그 아래 한 일이 줄로 들어간다 */
  .jobs { display: grid; gap: 10px; max-width: 54rem; }
  .job { border-radius: var(--radius-md); background: var(--color-panel); border: 1px solid var(--color-rule); box-shadow: var(--shadow-card); }
  .job-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.2rem 1rem; padding: 1.1rem 1.2rem; }
  .job-head h3 { flex: 1; min-width: 0; font-size: 1.1875rem; font-weight: 700; letter-spacing: -0.02em; line-height: 1.35; }
  .job-head h3 span { margin-left: 0.6rem; font-size: 0.9375rem; font-weight: 500; letter-spacing: 0; color: var(--color-ink-3); }
  .period { flex: none; font-size: 0.875rem; font-weight: 600; color: var(--color-ink-2); font-variant-numeric: tabular-nums; }
  /* 펼쳐지는 줄 */
  .acc { interpolate-size: allow-keywords; transition: background-color var(--dur-base); }
  .acc summary { display: flex; align-items: center; gap: 1rem; min-height: 48px; padding: 0.5rem 1.2rem; cursor: pointer; list-style: none; }
  .acc summary::-webkit-details-marker { display: none; }
  .job > .acc { border-top: 1px solid var(--color-rule); }
  .job > .acc:last-child { border-radius: 0 0 var(--radius-md) var(--radius-md); }
  .acc:hover, .acc[open] { background: var(--color-accent-soft); }
  .acc summary b { flex: 1; font-weight: 600; letter-spacing: -0.015em; }
  .acc summary :global(svg) { flex: none; align-self: center; color: var(--color-ink-3); transition: transform 0.4s var(--ease-spring); }
  .acc[open] > summary :global(svg) { transform: rotate(180deg); }
  .when { flex: none; width: 4.6rem; white-space: nowrap; font-size: 0.8125rem; font-weight: 600; color: var(--color-ink-3); font-variant-numeric: tabular-nums; }
  .acc p { padding: 0 1.2rem 1rem calc(1.2rem + 4.6rem + 1rem); color: var(--color-ink-2); line-height: 1.7; }
  .acc::details-content { block-size: 0; overflow: clip; transition: block-size 0.45s var(--ease-spring), content-visibility 0.45s allow-discrete; }
  .acc[open]::details-content { block-size: auto; }
  /* 한 일이 하나뿐인 회사: 카드 머리 자체가 펼치는 줄 */
  details.job > summary.job-head { align-items: baseline; padding: 1.1rem 1.2rem; }
  details.job p { padding: 0 1.2rem 1.1rem; }

  /* 연락 */
  .contact { display: flex; flex-direction: column; align-items: center; text-align: center; padding-block: clamp(3rem, 10vh, 6rem) clamp(4rem, 12vh, 7rem); }
  .motif { width: min(560px, 100%); height: auto; color: var(--color-ink); margin-bottom: 1rem; }
  .contact-lede { max-width: 36rem; margin-top: 1rem; color: var(--color-ink-2); }
  .contact-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin-top: 1.75rem; }
  .contact-mail { margin-top: 0.9rem; font-size: 0.875rem; font-weight: 600; color: var(--color-ink-3); }
  .contact-mail a { text-decoration: none; }
  .contact-mail a:hover { color: var(--color-ink); text-decoration: underline; }
  .copy-status { min-height: 1.5rem; margin-top: 0.4rem; font-size: 0.875rem; color: var(--color-ink-2); }

  @media (max-width: 760px) {
    .stats { gap: 1rem; }
    .stats dt { font-size: 0.8125rem; }
    .steps { grid-template-columns: 1fr; }
    .row { gap: 0.7rem; padding-inline: 1rem; }
    .row > :global(svg) { display: none; }
    .who { grid-template-columns: 1fr; gap: 1.1rem; }
    .photo { width: 112px; height: 112px; }
    .fields { grid-template-columns: 1fr; }
    .job-head, details.job > summary.job-head { padding-inline: 1rem; }
