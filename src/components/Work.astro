---
// 프로젝트 상세 본문. /work/[id]/ 와 /en/work/[id]/ 가 같이 쓴다.
// 순서: 머리(제목·요약·기간) → 한눈에 보기(흐름 + 문제·해결·결과, src/data/cases.ts) → 데모 화면 → 긴 글(접혀 있음).
// 2026-11-20 "글이 많다"는 피드백으로 긴 글은 지우지 않고 접어 두었다. "전체 기록 보기"를 누르면 펴진다.
// EN pages render src/content/projects-en/<id>.md when it exists, else fall back to the Korean body.
import { render, getCollection, getEntry, type CollectionEntry } from 'astro:content';
import { t, STATUS_LABEL, type Locale } from '../i18n';
import { CASES, fileNo } from '../data/cases';
import Icon from './Icon.astro';
import ProjectShots from './ProjectShots.astro';
import { PROJECT_SHOTS } from '../data/shots';

interface Props { locale: Locale; entry: CollectionEntry<'projects'>; }
const { locale, entry } = Astro.props;
const s = t[locale].detail;
const h = t[locale].home;
const en = locale === 'en';
const prefix = en ? '/en/' : '/';
const d = entry.data;
const enEntry = en ? await getEntry('projectsEn', entry.id) : undefined;
const { Content } = await render(enEntry ?? entry);
const bodyLang = enEntry ? 'en' : 'ko';
// 번호와 "다음"은 홈의 순서(src/data/cases.ts)를 따른다
const idx = CASES.findIndex((c) => c.id === entry.id);
const nextId = CASES[(idx + 1) % CASES.length].id;
const next = (await getCollection('projects')).find((p) => p.id === nextId);
if (idx < 0 || !next) throw new Error(`Work page for "${entry.id}": missing from src/data/cases.ts or next file "${nextId}" not found.`);
const title = en ? d.titleEn : d.title;
const copy = en ? CASES[idx].en : CASES[idx];
const psr = [copy.problem, copy.solution, copy.result];
// 기간이 "2026.03 – 운영 중"처럼 상태로 끝나면 옆의 상태 꼬리표와 겹치므로 "2026.03 –"까지만 보여 준다
const status = STATUS_LABEL[locale][d.status];
const span = en ? d.periodEn : d.period;
const period = span.endsWith(status) ? span.slice(0, -status.length).trimEnd() : span;
---
<article class="wrap work">
  {/* 홈으로 돌아가면 보던 프로젝트 단계가 다시 열린다 (#id는 Stage.astro가 읽는다) */}
  <a class="back" href={`${prefix}#${entry.id}`}><Icon name="arrow-left" size={18} />{s.back}</a>
  <header class="work-head">
    <div class="work-top">
      <span class="work-id">{fileNo(entry.id)}</span>
      <span class="label">{en ? CASES[idx].catEn : CASES[idx].cat}</span>
      <span class="label">{period}</span>
      <span class="status" data-status={d.status}>{status}</span>
    </div>
    <h1 class="work-title">{title}</h1>
    <p class="work-summary">{en ? d.summaryEn : d.summary}</p>
  </header>

  <section class="glance" aria-labelledby="glance-title">
    <h2 id="glance-title" class="sec-label">{h.glance}</h2>
    {/* 누구와, 어떤 역할로 했는지 (7단계 구조의 "내 역할") */}
    <p class="role"><b>{h.role}</b>{copy.role}</p>
    <ol class="flow" aria-label={h.flow}>
      {copy.flow.map((x, i) => <li class="rv" style={`--rv:${i}`}><b>{['IN', 'DO', 'OUT'][i]}</b><span>{x}</span></li>)}
    </ol>
    <dl class="psr">
      {psr.map((x, i) => <div class="rv" style={`--rv:${i}`}><dt>{h.psr[i]}</dt><dd>{x}</dd></div>)}
    </dl>
  </section>

  {en && !enEntry && (
    <p class="notice">
      The full write-up below is in Korean. <a href={`/work/${entry.id}/`} lang="ko">Read the Korean page</a> for the same content without the English header, or email me for an English walkthrough.
    </p>
  )}

  {PROJECT_SHOTS[entry.id] && <ProjectShots id={entry.id} locale={locale} />}

  {/* 긴 글은 접어 둔다. JS 없이도 펴지고, 브라우저의 페이지 내 검색은 접힌 글까지 찾아 펴 준다 */}
  <details class="more">
    <summary class="btn ghost"><span class="when-closed">{h.full}</span><span class="when-open">{h.fullClose}</span><Icon name="chevron-down" size={18} /></summary>
    <div class="prose" lang={bodyLang}><Content /></div>
  </details>

  <nav class="work-next" aria-label={s.next}>
    <span class="label">{s.next}</span>
    <a href={`${prefix}work/${next.id}/`}>{fileNo(next.id)} · {en ? next.data.titleEn : next.data.title}<Icon name="arrow-right" size={18} /></a>
  </nav>
</article>

<style>
  .work { padding-block: var(--space-lg) var(--space-3xl); }
  .back { display: inline-flex; align-items: center; gap: 0.35rem; min-height: 44px; font-size: var(--text-sm); font-weight: 600; color: var(--color-ink-3); text-decoration: none; transition: color var(--dur-base); }
  .back:hover { color: var(--color-ink); }
  .work-head { display: grid; gap: var(--space-md); padding-block: var(--space-lg) var(--space-xl); }
  .work-top { display: flex; align-items: center; gap: var(--space-sm); flex-wrap: wrap; }
  .work-id { padding: 0.2rem 0.7rem; border-radius: 999px; background: var(--color-ink); color: var(--color-paper); font-weight: 700; font-size: var(--text-sm); font-variant-numeric: tabular-nums; }
  .work-title { max-width: 18ch; font-size: clamp(2.2rem, 5.4vw, 4rem); line-height: 1.08; letter-spacing: -0.04em; }
  :global(html[lang="en"]) .work-title { max-width: 22ch; }
  .work-summary { max-width: 46rem; font-size: clamp(1.05rem, 1.6vw, 1.25rem); color: var(--color-ink-2); line-height: 1.6; }

  .glance { padding-bottom: var(--space-2xl); margin-bottom: var(--space-2xl); border-bottom: 1px solid var(--color-rule); }
  .glance .sec-label { margin-top: 0; }
  .role { display: flex; flex-wrap: wrap; gap: 0.25rem 0.75rem; align-items: baseline; margin: 0 0 var(--space-md); color: var(--color-ink-2); font-weight: 600; line-height: 1.6; }
  .role b { font-size: 0.8125rem; font-weight: 700; color: var(--color-ink-3); }
  /* 흐름: 들어온 것 → 한 일 → 나온 것. 칸 사이를 화살표로 잇는다 */
  .flow { list-style: none; margin: 0 0 12px; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .flow li { position: relative; display: grid; gap: 0.4rem; align-content: start; padding: 1.1rem 1.25rem; border-radius: var(--radius-md); background: var(--color-ink); color: var(--color-paper); }
  .flow li + li::before { content: "→"; position: absolute; left: -12px; top: 50%; transform: translate(-50%, -50%); display: grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; background: var(--color-paper); color: var(--color-ink); font-size: 0.8125rem; font-weight: 700; z-index: 1; }
  .flow b { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.08em; opacity: 0.6; }
  .flow span { font-weight: 600; line-height: 1.5; }
  .psr { margin: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .psr div { padding: 1.2rem 1.25rem; border-radius: var(--radius-md); background: var(--color-panel); border: 1px solid var(--color-rule); }
  .psr dt { font-size: 0.8125rem; font-weight: 700; color: var(--color-ink-3); }
  .psr dd { margin: 0.4rem 0 0; color: var(--color-ink-2); line-height: 1.7; }

  /* 접어 둔 긴 글 */
  .more > summary { display: inline-flex; align-items: center; gap: 0.4rem; cursor: pointer; list-style: none; }
  .more > summary::-webkit-details-marker { display: none; }
  .more > summary :global(svg) { transition: transform 0.4s var(--ease-spring); }
  .more[open] > summary :global(svg) { transform: rotate(180deg); }
  .more:not([open]) .when-open, .more[open] .when-closed { display: none; }
  .more .prose { margin-top: var(--space-xl); }

  .notice { max-width: var(--measure); font-size: var(--text-sm); color: var(--color-ink-2); background: var(--color-panel); border: 1px solid var(--color-rule); border-radius: var(--radius-md); padding: var(--space-sm) var(--space-md); margin-bottom: var(--space-xl); }
  .work-next { margin-top: var(--space-2xl); padding-top: var(--space-lg); border-top: 1px solid var(--color-rule); display: grid; gap: var(--space-2xs); }
  .work-next a { display: inline-flex; align-items: center; gap: 0.4rem; text-decoration: none; font-weight: 700; font-size: 1.125rem; }
  .work-next a:hover { text-decoration: underline; }

  @media (max-width: 760px) {
    .flow, .psr { grid-template-columns: 1fr; }
    .flow li + li::before { content: "↓"; left: 50%; top: -6px; }
  }
</style>
