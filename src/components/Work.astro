---
// Project detail body, shared by /work/[id]/ and /en/work/[id]/.
// EN pages render src/content/projects-en/<id>.md when it exists, else fall back to the Korean body.
import { render, getCollection, getEntry, type CollectionEntry } from 'astro:content';
import { t, STATUS_LABEL, type Locale } from '../i18n';
import { CASES, fileNo } from '../data/cases';

interface Props { locale: Locale; entry: CollectionEntry<'projects'>; }
const { locale, entry } = Astro.props;
const s = t[locale].detail;
const en = locale === 'en';
const prefix = en ? '/en/' : '/';
const d = entry.data;
const enEntry = en ? await getEntry('projectsEn', entry.id) : undefined;
const { Content } = await render(enEntry ?? entry);
const bodyLang = enEntry ? 'en' : 'ko';
// numbering and "next" follow the home page's file order (src/data/cases.ts)
const idx = CASES.findIndex((c) => c.id === entry.id);
const nextId = CASES[(idx + 1) % CASES.length].id;
const next = (await getCollection('projects')).find((p) => p.id === nextId);
if (idx < 0 || !next) throw new Error(`Work page for "${entry.id}": missing from src/data/cases.ts or next file "${nextId}" not found.`);
const title = en ? d.titleEn : d.title;
---
<article class="wrap work">
  <a class="back" href={`${prefix}#files`}>{s.back}</a>
  <header class="work-head">
    <div class="work-top">
      <span class="work-id" data-clay={idx % 5}>{fileNo(entry.id)}</span>
      <span class="label">{en ? CASES[idx].catEn : CASES[idx].cat}</span>
      <span class="status" data-status={d.status}>{STATUS_LABEL[locale][d.status]}</span>
    </div>
    <h1 class="work-title">{title}</h1>
    <p class="work-summary">{en ? d.summaryEn : d.summary}</p>
    <dl class="record work-meta">
      <dt>{s.period}</dt><dd>{en ? d.periodEn : d.period}</dd>
      <dt>{s.stack}</dt><dd class="mono">{d.stack.join(' · ')}</dd>
      <dt>{s.replaced}</dt><dd>{en ? d.replacedEn : d.replaced}</dd>
    </dl>
  </header>

  {en && !enEntry && (
    <p class="notice">
      The full write-up below is in Korean. <a href={`/work/${entry.id}/`} lang="ko">Read the Korean page</a> for the same content without the English header, or email me for an English walkthrough.
    </p>
  )}

  <div class="prose" lang={bodyLang}><Content /></div>

  <nav class="work-next" aria-label={s.next}>
    <span class="label">{s.next}</span>
    <a href={`${prefix}work/${next.id}/`}>{fileNo(next.id)} · {en ? next.data.titleEn : next.data.title} →</a>
  </nav>
</article>

<style>
  .work { padding-block: var(--space-xl) var(--space-2xl); }
  .back { display: inline-flex; align-items: center; min-height: 44px; font-size: var(--text-sm); font-weight: 700; color: var(--color-ink-3); text-decoration: none; margin-bottom: var(--space-md); }
  .back:hover { color: var(--color-ink); }
  .work-head { display: grid; gap: var(--space-md); max-width: 44rem; padding-bottom: var(--space-xl); border-bottom: var(--rule); margin-bottom: var(--space-xl); }
  .work-top { display: flex; align-items: center; gap: var(--space-sm); flex-wrap: wrap; }
  .work-id { padding: 0.2rem 0.7rem; border-radius: 999px; background: var(--clay); color: var(--clay-on); font-weight: 800; font-size: var(--text-sm); font-variant-numeric: tabular-nums; }
  .work-title { font-size: clamp(2.2rem, 5vw, 3.75rem); line-height: 1.12; }
  .work-summary { font-size: var(--text-lg); color: var(--color-ink-2); line-height: 1.5; }
  .work-meta { margin-top: var(--space-sm); }
  .notice { max-width: var(--measure); font-size: var(--text-sm); color: var(--color-ink-2); background: var(--color-paper-2); border: var(--rule); border-radius: var(--radius-md); padding: var(--space-sm) var(--space-md); margin-bottom: var(--space-xl); }
  .work-next { margin-top: var(--space-2xl); padding-top: var(--space-lg); border-top: var(--rule); display: grid; gap: var(--space-2xs); }
  .work-next a { text-decoration: none; font-weight: 600; }
  .work-next a:hover { text-decoration: underline; }
</style>
