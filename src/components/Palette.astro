---
// ⌘K command palette: searches modules (projects) and sections. Vanilla JS, no deps.
import type { Locale } from '../i18n';
import { t } from '../i18n';
interface Item { label: string; hint: string; href: string; }
interface Props { locale: Locale; items: Item[]; }
const { locale, items } = Astro.props;
const s = t[locale].palette;
---
<div class="palette" data-palette hidden>
  <div class="palette-backdrop" data-palette-close></div>
  <div class="palette-box" role="dialog" aria-modal="true" aria-label={t[locale].search}>
    <input class="palette-input" type="search" placeholder={s.placeholder} autocomplete="off" spellcheck="false" data-palette-input />
    <ul class="palette-list" role="listbox" data-palette-list>
      {items.map((it, i) => (
        <li role="option" data-item data-search={`${it.label} ${it.hint}`.toLowerCase()} aria-selected={i === 0 ? 'true' : 'false'}>
          <a href={it.href}><span class="palette-label">{it.label}</span><span class="palette-hint mono">{it.hint}</span></a>
        </li>
      ))}
      <li class="palette-empty mono" data-palette-empty hidden>{s.empty}</li>
    </ul>
    <div class="palette-foot mono">{s.hint}</div>
  </div>
</div>

<style>
  .palette[hidden] { display: none; }
  .palette { position: fixed; inset: 0; z-index: 50; display: grid; place-items: start center; padding-top: 12vh; }
  .palette-backdrop { position: absolute; inset: 0; background: oklch(20% 0.01 260 / 0.35); }
  .palette-box {
    position: relative; width: min(560px, calc(100vw - 2rem));
    background: var(--color-paper); border: var(--rule); border-radius: var(--radius-md);
    box-shadow: 0 20px 60px oklch(20% 0.01 260 / 0.18); overflow: hidden;
  }
  .palette-input {
    width: 100%; border: 0; border-bottom: var(--rule); background: transparent; color: var(--color-ink);
    font: inherit; font-size: var(--text-base); padding: 0.9rem 1rem; outline: none;
  }
  .palette-list { list-style: none; margin: 0; padding: 0.35rem; max-height: 50vh; overflow-y: auto; }
  .palette-list li[data-item] a {
    display: flex; justify-content: space-between; gap: var(--space-md); align-items: baseline;
    padding: 0.55rem 0.7rem; border-radius: var(--radius-sm); text-decoration: none; font-size: var(--text-sm);
  }
  .palette-list li[aria-selected="true"] a { background: var(--color-paper-2); }
  .palette-list li[data-item] a:hover { background: var(--color-paper-3); }
  .palette-hint { font-size: var(--text-xs); color: var(--color-ink-3); white-space: nowrap; }
  .palette-empty { padding: 0.8rem; color: var(--color-ink-3); font-size: var(--text-xs); }
  .palette-foot { border-top: var(--rule); padding: 0.45rem 1rem; font-size: var(--text-xs); color: var(--color-ink-3); }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-palette]');
  const input = root?.querySelector<HTMLInputElement>('[data-palette-input]');
  const items = Array.from(root?.querySelectorAll<HTMLLIElement>('[data-item]') ?? []);
  const empty = root?.querySelector<HTMLElement>('[data-palette-empty]');
  if (root && input) {
    const open = () => { root.hidden = false; input.value = ''; filter(); input.focus(); };
    const close = () => { root.hidden = true; };
    const visible = () => items.filter((li) => !li.hidden);
    const select = (idx: number) => {
      const vis = visible();
      vis.forEach((li, i) => li.setAttribute('aria-selected', i === idx ? 'true' : 'false'));
      vis[idx]?.scrollIntoView({ block: 'nearest' });
    };
    const filter = () => {
      const q = input.value.trim().toLowerCase();
      let n = 0;
      for (const li of items) { const hit = !q || (li.dataset.search ?? '').includes(q); li.hidden = !hit; if (hit) n++; }
      if (empty) empty.hidden = n > 0;
      select(0);
    };
    document.querySelectorAll('[data-open-palette]').forEach((b) => b.addEventListener('click', open));
    root.querySelectorAll('[data-palette-close]').forEach((b) => b.addEventListener('click', close));
    input.addEventListener('input', filter);
    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); root.hidden ? open() : close(); return; }
      if (root.hidden) return;
      const vis = visible();
      const cur = vis.findIndex((li) => li.getAttribute('aria-selected') === 'true');
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowDown') { e.preventDefault(); select(Math.min(cur + 1, vis.length - 1)); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); select(Math.max(cur - 1, 0)); }
      else if (e.key === 'Enter') { const a = vis[cur]?.querySelector('a'); if (a) { close(); a.click(); } }
    });
    root.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) close(); });
  }
</script>
