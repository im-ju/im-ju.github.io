---
// 홈 첫 구역: 노트북 하나. 제목과 노트북 안 화면이 단계마다 다음 프로젝트로 바뀐다.
// 0단계 = 소개, 1…N단계 = src/data/cases.ts 순서대로의 프로젝트.
// 단계는 버튼으로만 넘긴다: 노트북 왼쪽 메뉴 · 점 레일 · "다음" · 재생 버튼. 이 구역은 보통 구역처럼 스크롤에 그대로 지나간다.
// (2026-11-20까지는 화면에 고정해 스크롤로 넘겼다. "복잡하다", "휴대폰에서 스크롤이 튄다"는 피드백으로 스크롤 연동을 전부 뺐다.
//  스크립트는 스크롤 위치를 읽지도 움직이지도 않는다.)
import type { ComponentProps } from 'astro/types';
import { t, type Locale } from '../i18n';
import Icon from './Icon.astro';
import Row from './demo/Row.astro';

type IconName = ComponentProps<typeof Icon>['name'];
interface StageFile { id: string; short: string; title: string; href: string; icon: IconName; }
interface Props { locale: Locale; files: StageFile[]; }
const { locale, files } = Astro.props;
const s = t[locale];
const h = s.home;
const tr = h.tour;
const en = locale === 'en';
const L = (ko: string, enText: string) => (en ? enText : ko);
const N = files.length + 1;

// 데모 화면 순서는 프로젝트 id로 찾는다. 프로젝트를 추가했는데 화면을 안 그렸으면 빌드에서 멈춘다.
const PANES = ['hris', 'hrga-hub', 'meal-allowance', 'interview-reminder', 'guide-redesign', 'asset-regulation'];
const missing = files.filter((f) => !PANES.includes(f.id)).map((f) => f.id);
if (missing.length) throw new Error(`Stage.astro has no demo screen for: ${missing.join(', ')}. Add a <div class="pane"> for it.`);
const step = (id: string) => {
  const i = files.findIndex((f) => f.id === id);
  if (i < 0) throw new Error(`Stage.astro draws a demo for "${id}" but src/data/cases.ts does not list it.`);
  return i + 1;
};
const file = (id: string) => files[step(id) - 1];

// 소개 화면의 인사기록 줄: [아이콘, 항목, 값, 보조 설명]
const fieldIcons: IconName[] = ['building', 'calendar', 'chat', 'cap'];
const record = s.hero.fields
  .filter(([k]) => k !== '근무지' && k !== 'Location')
  .map(([k, v], i) => { const [main, ...rest] = v.split(', '); return { icon: fieldIcons[i], key: k, value: main, sub: rest.join(', ') }; });

---
<section id="tour" class="tour" data-steps={N} data-ids={['', ...files.map((f) => f.id)].join(',')} style={`--n:${N}`} aria-label={tr.rail}>
  {/* 무대 바탕색(.shade)은 내용(.stage)과 따로 둔다: 화면 전체에 깔린 점 무늬(Base.astro의 .field)가 바탕색 위, 내용 아래로 지나가야 해서 */}
  <div class="shade" aria-hidden="true"></div>
  <div class="stage">
    <div class="col">
      <div class="titles">
        <div class="t-item on" data-i="0">
          <h1>{h.h1.join(' ')}</h1>
          <p>{h.desc}</p>
        </div>
        {files.map((f, i) => (
          <div class="t-item" data-i={i + 1}>
            <h2>{f.short}</h2>
            <p>{f.title}</p>
          </div>
        ))}
      </div>

      <div class="device">
        {/* 화면 안은 장식 겸 마우스용 바로가기. 키보드·스크린리더는 아래 점 레일로 같은 일을 한다 */}
        <div class="lid" aria-hidden="true">
          <div class="screen">
            <div class="app">
              <aside class="side">
                <div class="traffic"><i></i><i></i><i></i></div>
                <div class="s-search"><Icon name="search" /><span>{tr.search}</span></div>
                <div class="s-nav">
                  <span class="s-hl"></span>
                  <button type="button" class="side-item on" data-i="0" data-go="0" tabindex="-1"><span class="tile"><Icon name="home" /></span><span class="nm">{L('홈', 'Home')}</span></button>
                  <span class="s-label">{h.filesTitle(files.length)}</span>
                  {files.map((f, i) => (
                    <button type="button" class="side-item" data-i={i + 1} data-go={i + 1} tabindex="-1"><span class="tile"><Icon name={f.icon} /></span><span class="nm">{f.short}</span></button>
                  ))}
                </div>
                <div class="s-status"><i class="dot"></i><div><b>{tr.employed}</b><span>{L('DSRV · 인사총무팀', 'DSRV · HR & GA')}</span></div></div>
              </aside>

              <div class="main">
                {/* 0 · 소개 */}
                <div class="pane on" data-i="0">
                  <header class="p-head">
                    <img class="p-photo" src="/juyoung.jpg" width="800" height="800" alt="" />
                    <div><b>{s.hero.name}</b><span class="chip"><i class="dot live"></i>{tr.employed}</span></div>
                  </header>
                  <p class="p-label">{h.recordTitle}</p>
                  <div class="p-list">
                    {record.map((r, i) => (
                      <Row icon={r.icon} title={r.key} sub={r.sub || undefined} at={150 + i * 110} hideOnPhone={i > 1}><span class="p-val">{r.value}</span></Row>
                    ))}
                  </div>
                  <p class="p-label">{L('자동화 설정', 'Automation')}</p>
                  <div class="p-list">
                    <Row icon="check" title={L('확인 업무 자동화', 'Automate the checking')} sub={L('손으로 하던 대조는 규칙이 대신합니다', 'Rules do the matching people did by hand')} at={650}><span class="tg" data-init="off" data-flip="1300"></span></Row>
                    <Row icon="lock" title={L('발송 · 삭제 자동화', 'Automate sending and deleting')} sub={L('되돌릴 수 없는 일은 사람이 결정합니다', 'What cannot be undone is decided by a person')} at={760}><span class="tg" data-init="off"></span></Row>
                  </div>
                </div>

                {/* 사내 HRIS: 개발 중인 시스템의 홈 화면을 본뜬 예시. 근무시간·요청은 가상, 단계와 범위는 프로젝트 글 그대로 */}
                <div class="pane" data-i={step('hris')}>
                  <header class="p-head"><span class="tile"><Icon name="users" /></span><div><b>{file('hris').short}</b><span class="sub">{L('PO로 와이어프레임부터 개발까지 이끌고 있습니다', 'Leading it as product owner, from wireframes to build')}</span></div></header>
                  <div class="sg m-hide"><span>{L('와이어프레임', 'Wireframes')}</span><span class="on">{L('개발 중', 'In development')}</span><span>{L('전사 테스트 · 2026년 말 목표', 'Company-wide test · goal: end of 2026')}</span></div>
                  <p class="p-label">{L('오늘', 'Today')}</p>
                  <div class="p-list">
                    <Row icon="clock" title={L('이번 주 근무', 'Hours this week')} sub={L('출퇴근 · 외근 · 원격 근무', 'Office · field · remote')} at={150}><span class="bar" data-at="500" style="--to:70%"><i></i></span><span class="p-val">28 / 40{L('시간', 'h')}</span></Row>
                    <Row icon="calendar" title={L('직원 A · 연차', 'Employee A · annual leave')} sub={L('같은 기간에 팀원 휴가 1건', 'One teammate is off on the same days')} at={260}>
                      <span class="swap" data-at="1900"><span class="pbtn">{L('승인', 'Approve')}</span><span class="chip line">{L('승인됨', 'Approved')} ✓</span></span>
                    </Row>
                    <Row icon="home" title={L('직원 B · 원격 근무', 'Employee B · remote work')} sub={L('내일', 'Tomorrow')} at={370}><span class="chip">{L('승인 대기', 'Waiting')}</span></Row>
                  </div>
                  <div class="p-list m-hide">
                    <Row icon="file" title={L('회사 규정이 곧 설정값', 'Company rules are the settings')} sub={L('연차 발생 · 근무 유형 · 휴가 종류를 출처와 함께 한 파일에', 'Leave grants, work types and leave types in one file, with sources')} at={700}><span class="tg on" data-init="on"></span></Row>
                  </div>
                  <div class="chips">
                    {[L('구성원 · 조직도', 'People & org chart'), L('근무', 'Attendance'), L('휴가', 'Leave'), L('평가 · 채용', 'Reviews & recruiting'), L('승인 정책 · 권한', 'Approval policy & permissions'), L('통계 · 감사 로그', 'Stats & audit log')].map((c, i) => (
                      <span class="chip rvl" data-at={900 + i * 130}>{c}</span>
                    ))}
                  </div>
                </div>

                {/* HR/GA Hub */}
                <div class="pane" data-i={step('hrga-hub')}>
                  <header class="p-head"><span class="tile"><Icon name="grid" /></span><div><b>HR/GA Hub</b><span class="sub">{L('회사 계정 하나로 들어가는 사내 웹앱', 'One internal web app behind the company account')}</span></div></header>
                  <div class="sg m-hide"><span class="on">{L('회의실', 'Rooms')}</span><span>{L('이벤트', 'Events')}</span><span>{L('자기계발비', 'Training')}</span></div>
                  <p class="p-label m-hide">{L('오늘 회의실', 'Meeting rooms today')}</p>
                  <div class="p-list">
                    <Row icon="users" title={L('회의실 A', 'Room A')} sub={L('6인 · 10:00 – 11:00', '6 seats · 10:00 – 11:00')} at={150}><span class="chip dark">{L('사용 중', 'In use')}</span></Row>
                    <Row icon="users" title={L('회의실 B', 'Room B')} sub={L('4인 · 11:30부터', '4 seats · from 11:30')} at={260}><span class="chip">{L('곧 시작', 'Starting soon')}</span></Row>
                    <Row icon="users" title={L('회의실 C', 'Room C')} sub={L('10인 · 비어 있음', '10 seats · free')} at={370}>
                      <span class="swap" data-at="1900"><span class="pbtn">{L('예약', 'Book')}</span><span class="chip line">{L('예약됨', 'Booked')} ✓</span></span>
                    </Row>
                  </div>
                  <p class="p-label m-hide">{L('기능 6개', '6 features')}</p>
                  <div class="chips">
                    {[L('회의실', 'Meeting rooms'), L('사내 이벤트', 'Company events'), L('구성원 디렉토리', 'Member directory'), L('제휴식당', 'Partner restaurants'), L('자기계발비', 'Training allowance'), L('근속 알림', 'Anniversary alerts')].map((c, i) => (
                      <span class="chip rvl" data-at={700 + i * 130}>{c}</span>
                    ))}
                  </div>
                </div>

                {/* 식대 검증 */}
                <div class="pane" data-i={step('meal-allowance')}>
                  <header class="p-head"><span class="tile"><Icon name="receipt" /></span><div><b>{file('meal-allowance').short}</b><span class="sub">{L('식권 사용 내역과 근태 기록을 규칙으로 대조', 'Meal-card usage checked against attendance, by rule')}</span></div></header>
                  <p class="p-label">{L('식권 사용 ↔ 근태 기록', 'Meal card ↔ attendance')}</p>
                  <div class="p-list">
                    <Row icon="user" title={L('직원 A · 석식', 'Employee A · dinner')} sub={L('퇴근 기록과 대조', 'Matched with clock-out')} at={150}><span class="chip rvl" data-at="900">{L('요건 충족', 'Eligible')} ✓</span></Row>
                    <Row icon="user" title={L('직원 B · 석식', 'Employee B · dinner')} sub={L('퇴근 기록과 대조', 'Matched with clock-out')} at={260}><span class="chip dark rvl" data-at="1500">{L('차감', 'Deduct')}</span></Row>
                    <Row icon="user" title={L('직원 C · 석식', 'Employee C · dinner')} sub={L('근태 기록 없음', 'No attendance record')} at={370}><span class="chip line rvl" data-at="2100">{L('별도 확인', 'Manual review')}</span></Row>
                  </div>
                  <p class="p-label m-hide">{L('차감 사유 문장', 'Deduction reason')}</p>
                  <div class="typebox"><span data-type={L('직원 B: 석식을 이용한 날의 근무 종료 시각이 지원 요건보다 이릅니다.', 'Employee B: on the day dinner was used, work ended earlier than the rule requires.')} data-delay="2500"></span><i class="caret"></i></div>
                  <div class="p-list m-hide">
                    <Row icon="check" title={L('대조 진행', 'Matching')}><span class="bar" data-at="500" style="--to:100%"><i></i></span><span class="p-val">3 / 3</span></Row>
                  </div>
                </div>

                {/* 면접 전날(D-1) 리마인드 메일 */}
                <div class="pane" data-i={step('interview-reminder')}>
                  <header class="p-head"><span class="tile"><Icon name="mail" /></span><div><b>{file('interview-reminder').short}</b><span class="sub">{L('초안까지만 자동, 보내기는 사람이', 'Drafts are automatic; a person presses send')}</span></div></header>
                  <div class="p-list">
                    <Row icon="calendar" title={L('직무 면접 · 후보자 A', 'Role interview · Candidate A')} sub={L('공유 캘린더 · 내일 14:00', 'Shared calendar · tomorrow 14:00')} at={150}><span class="chip rvl" data-at="800">{L('유형: 직무', 'Type: role')}</span></Row>
                  </div>
                  <p class="p-label">{L('리마인드 메일 초안', 'Reminder draft')}</p>
                  <div class="typebox tall"><span data-type={L('안녕하세요, 후보자 A님. 내일 14:00 직무 면접 일정을 다시 안내드립니다. 장소와 준비물은 아래와 같습니다.', 'Hello Candidate A. This is a reminder of your role interview tomorrow at 14:00. The location and what to bring are below.')} data-delay="1100"></span><i class="caret"></i>
                    <span class="chip dark rvl saved" data-at="4300">{L('임시보관함에 저장됨', 'Saved to Drafts')} ✓</span>
                  </div>
                  <p class="p-label m-hide">{L('설정', 'Settings')}</p>
                  <div class="p-list m-hide">
                    <Row icon="pen" title={L('초안 자동 작성', 'Write drafts automatically')} sub={L('매일 아침 내일 면접을 찾습니다', "Every morning it finds tomorrow's interviews")}><span class="tg on" data-init="on"></span></Row>
                    <Row icon="lock" title={L('자동 발송', 'Send automatically')} sub={L('보낸 메일은 되돌릴 수 없어 사람이 누릅니다', 'A sent email cannot be taken back, so a person sends it')}><span class="tg" data-init="off"></span></Row>
                  </div>
                </div>

                {/* 안내서 이관 */}
                <div class="pane" data-i={step('guide-redesign')}>
                  <header class="p-head"><span class="tile"><Icon name="scale" /></span><div><b>{file('guide-redesign').short}</b><span class="sub">{L('원본을 건드리지 않는 이관 리허설', 'A migration rehearsal that never touches the original')}</span></div></header>
                  <div class="p-list">
                    <Row icon="list" title={L('섹션', 'Sections')}><span class="p-val">{L('8개 유지', '8 kept')}</span></Row>
                    <Row icon="file" title={L('하위 페이지', 'Child pages')}><span class="p-val"><span data-count="46" data-delay="2000">46</span> / 46 {L('유지', 'kept')}</span></Row>
                  </div>
                  <p class="p-label m-hide">{L('리허설', 'Rehearsal')}</p>
                  <div class="term">
                    <p><b>$</b> <span data-type="migrate --rehearsal" data-delay="400"></span><i class="caret"></i></p>
                    <p class="rvl" data-at="1500">layout   {L('새 레이아웃만 가져옴', 'new layout only')} … ok</p>
                    <p class="rvl" data-at="2000">pages    46 / 46 {L('보존', 'preserved')}</p>
                    <p class="rvl" data-at="2900">source   {L('변경 없음', 'unchanged')}</p>
                    <p class="rvl" data-at="3500"><b>✔ {L('리허설 통과', 'rehearsal passed')}</b></p>
                  </div>
                  <div class="p-list m-hide">
                    <Row icon="lock" title={L('원본 페이지', 'Original pages')} sub={L('이관 중에도 그대로 둡니다', 'Left as they are during the move')} at={3900}><span class="chip dark">{L('변경 없음', 'Unchanged')}</span></Row>
                  </div>
                </div>

                {/* 자산관리 규정 */}
                <div class="pane" data-i={step('asset-regulation')}>
                  <header class="p-head"><span class="tile"><Icon name="file" /></span><div><b>{file('asset-regulation').short}</b><span class="sub">{L('세 관점으로 다시 쓰고 대표이사 승인', 'Rewritten from three angles, approved by the CEO')}</span></div></header>
                  <div class="sg cycle m-hide"><span>{L('법 · 세무', 'Legal & tax')}</span><span>{L('정보보안', 'Security')}</span><span>{L('실무', 'Practice')}</span></div>
                  <div class="p-list">
                    <Row icon="pen" title={L('개정 반영', 'Changes made')} at={300}><span class="p-val"><span data-count="15" data-delay="500">15</span>{L('건', '')}</span></Row>
                    <Row icon="clock" title={L('노후화 기준', 'Obsolescence standard')} at={500}><span class="chip">{L('신설', 'New')}</span></Row>
                    <Row icon="users" title={L('교체 대상 추천', 'Replacement picks')} at={700}><span class="p-val"><span data-count="17" data-delay="900">17</span>{L('명', '')}</span></Row>
                    <Row icon="check-circle" title={L('대표이사 결재', 'CEO sign-off')} at={900}><span class="chip dark rvl" data-at="2600">{L('승인', 'Approved')}</span></Row>
                  </div>
                  <div class="stamp" data-at="2600"><b>{L('승인', 'OK')}</b></div>
                </div>

                <span class="sample">{tr.sample}</span>
              </div>
            </div>
            {/* 테마 전환용: .flip이 화면을 뒤집어 어두운 화면으로 만들고, .dust에 경계의 입자를 그린다 (아래 스크립트) */}
            <div class="flip"></div>
            <canvas class="dust"></canvas>
          </div>
        </div>
        <div class="base" aria-hidden="true"></div>

        <div class="controls">
          <nav class="rail" aria-label={tr.rail}>
            <button type="button" data-i="0" data-go="0" aria-label={tr.intro} aria-current="step"><i></i><span class="tip" aria-hidden="true">{tr.intro}</span></button>
            {files.map((f, i) => (
              <button type="button" data-i={i + 1} data-go={i + 1} aria-label={f.short}><i></i><span class="tip" aria-hidden="true">{f.short}</span></button>
            ))}
          </nav>
          <button type="button" class="play" aria-pressed="false" aria-label={tr.play} data-play={tr.play} data-pause={tr.pause}>
            <span class="i-play"><Icon name="play" size={14} /></span><span class="i-pause"><Icon name="pause" size={14} /></span>
          </button>
        </div>
      </div>

      <div class="acts">
        <div class="act on" data-i="0">
          <div class="act-btns">
            <button type="button" class="btn" data-go="1">{tr.start}</button>
            <a class="btn ghost" href="#contact">{h.ctaContact}</a>
          </div>
        </div>
        {files.map((f, i) => (
          <div class="act" data-i={i + 1}>
            <div class="act-btns">
              <a class="btn" href={f.href}>{h.open}</a>
              {i + 2 < N
                ? <button type="button" class="btn ghost" data-go={i + 2}>{tr.next}<Icon name="arrow-right" size={16} /></button>
                : <a class="btn ghost" href="#files">{h.filesTitle(files.length)}</a>}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const tour = document.querySelector<HTMLElement>('.tour');
  if (tour) {
    const stage = tour.querySelector<HTMLElement>('.stage')!;
    const N = Number(tour.dataset.steps);
    const ids = tour.dataset.ids!.split(','); // ids[0] = '' (소개)
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const all = <T extends HTMLElement>(sel: string) => [...tour.querySelectorAll<T>(sel)];
    const stacked = all('.t-item, .pane, .act');       // 한 번에 하나만 보이는 것들
    const marks = all('.rail button, .side-item');     // 현재 단계를 표시하는 것들
    const hl = tour.querySelector<HTMLElement>('.s-hl')!;
    const play = tour.querySelector<HTMLButtonElement>('.play')!;
    // 단계마다 무대 바탕 밝기를 조금씩 바꾼다 (참고: 어두운 테마 기준 %, 밝은 테마는 site.css의 --stage-swing이 뒤집어 줄인다)
    const SHADES = [0, -8, -3, 6, -6, 3, -9, 5, -2]; // ← 단계별 밝기 차이

    let inView = true; // 무대가 화면에 보이는지

    let cur = -1;
    let timers: number[] = [];
    const later = (fn: () => void, ms: number) => { timers.push(window.setTimeout(fn, ms)); };
    const stopTimeline = () => { timers.forEach(clearTimeout); timers = []; };

    // 화면 하나의 움직임: data-at(등장 시각), data-type(타자), data-flip(토글 뒤집기), data-count(숫자 올라가기)
    function reset(pane: HTMLElement) {
      pane.querySelectorAll<HTMLElement>('[data-at]').forEach((el) => el.classList.remove('show'));
      pane.querySelectorAll<HTMLElement>('[data-type]').forEach((el) => { el.textContent = ''; });
      pane.querySelectorAll<HTMLElement>('[data-init]').forEach((el) => el.classList.toggle('on', el.dataset.init === 'on'));
      pane.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => { el.textContent = '0'; });
    }
    function finish(pane: HTMLElement) {
      pane.querySelectorAll<HTMLElement>('[data-at]').forEach((el) => el.classList.add('show'));
      pane.querySelectorAll<HTMLElement>('[data-type]').forEach((el) => { el.textContent = el.dataset.type!; });
      pane.querySelectorAll<HTMLElement>('[data-flip]').forEach((el) => el.classList.toggle('on', el.dataset.init !== 'on'));
      pane.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => { el.textContent = el.dataset.count!; });
    }
    function run(pane: HTMLElement) {
      stopTimeline();
      if (reduce) { finish(pane); return; }
      if (!inView) return; // 안 보이는 동안에는 돌리지 않는다. 다시 보이면 아래 관찰자가 처음부터 돌린다
      reset(pane);
      let end = 0;
      pane.querySelectorAll<HTMLElement>('[data-at]').forEach((el) => {
        const at = Number(el.dataset.at); end = Math.max(end, at + 600);
        later(() => el.classList.add('show'), at);
      });
      pane.querySelectorAll<HTMLElement>('[data-flip]').forEach((el) => {
        const at = Number(el.dataset.flip); end = Math.max(end, at + 600);
        later(() => el.classList.toggle('on'), at);
      });
      pane.querySelectorAll<HTMLElement>('[data-type]').forEach((el) => {
        const text = el.dataset.type!; const at = Number(el.dataset.delay ?? 0); const speed = 30;
        end = Math.max(end, at + text.length * speed + 400);
        for (let k = 1; k <= text.length; k++) later(() => { el.textContent = text.slice(0, k); }, at + k * speed);
      });
      pane.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
        const to = Number(el.dataset.count); const at = Number(el.dataset.delay ?? 0); const frames = 18;
        end = Math.max(end, at + 900);
        for (let k = 1; k <= frames; k++) later(() => { el.textContent = String(Math.round((to * k) / frames)); }, at + k * 45);
      });
      later(() => { if (!document.hidden) run(pane); else later(() => run(pane), 3000); }, end + 4200); // 다 보여준 뒤 잠시 멈췄다가 처음부터 다시
    }

    function placeHighlight() {
      const item = tour!.querySelector<HTMLElement>('.side-item.on');
      if (item) { hl.style.setProperty('--y', `${item.offsetTop}px`); hl.style.setProperty('--h', `${item.offsetHeight}px`); }
    }

    // 왼쪽 메뉴에서 고른 항목의 아이콘이 화면 머리 자리로 날아와 앉는다 (휴대폰에는 왼쪽 메뉴가 없어 건너뛴다)
    const scr = tour.querySelector<HTMLElement>('.screen')!;
    let landGhost: (() => void) | null = null; // 날아가는 아이콘은 한 번에 하나만
    function fly(i: number) {
      landGhost?.();
      const from = tour!.querySelector<HTMLElement>(`.side-item[data-i="${i}"] .tile`);
      const to = tour!.querySelector<HTMLElement>(`.pane[data-i="${i}"] .p-head > .tile`);
      if (reduce || !from || !to || !from.offsetParent) return;
      const box = scr.getBoundingClientRect(), a = from.getBoundingClientRect();
      // 도착 자리는 움직임(transform)을 뺀 원래 자리로 잰다: 화면이 올라오는 중이라 지금 보이는 좌표는 아직 어긋나 있다
      let x = 0, y = 0;
      for (let el: HTMLElement | null = to; el && el !== scr; el = el.offsetParent as HTMLElement | null) { x += el.offsetLeft; y += el.offsetTop; }
      const ghost = to.cloneNode(true) as HTMLElement;
      ghost.classList.add('fly');
      Object.assign(ghost.style, { left: `${x}px`, top: `${y}px`, width: `${to.offsetWidth}px`, height: `${to.offsetHeight}px` });
      scr.querySelector('.app')!.append(ghost);
      to.style.visibility = 'hidden';
      const done = () => { ghost.remove(); to.style.visibility = ''; if (landGhost === done) landGhost = null; };
      landGhost = done;
      ghost.animate(
        [{ transform: `translate(${a.left - box.left - x}px, ${a.top - box.top - y}px) scale(${a.width / to.offsetWidth})` }, { transform: 'none' }],
        { duration: 620, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' }, // ← 날아가는 시간(ms)
      ).finished.then(done, done);
    }

    function setStep(i: number) {
      if (i === cur) return;
      const first = cur < 0;
      cur = i;
      tour!.dataset.step = String(i);
      tour!.style.setProperty('--dl-raw', `${SHADES[i % SHADES.length]}%`);
      stacked.forEach((el) => { const on = Number(el.dataset.i) === i; el.classList.toggle('on', on); el.inert = !on; });
      marks.forEach((el) => {
        const on = Number(el.dataset.i) === i;
        el.classList.toggle('on', on);
        if (el.closest('.rail')) on ? el.setAttribute('aria-current', 'step') : el.removeAttribute('aria-current');
      });
      placeHighlight();
      const pane = tour!.querySelector<HTMLElement>(`.pane[data-i="${i}"]`);
      if (pane) run(pane);
      if (!first) fly(i);
    }

    const goTo = (i: number) => setStep(Math.max(0, Math.min(N - 1, i)));
    addEventListener('resize', placeHighlight);

    tour.addEventListener('click', (e) => {
      const go = (e.target as HTMLElement).closest<HTMLElement>('[data-go]');
      if (go) { stopAuto(); goTo(Number(go.dataset.go)); }
    });
    tour.querySelector('.rail')!.addEventListener('keydown', (e) => {
      const k = (e as KeyboardEvent).key;
      const d = k === 'ArrowDown' || k === 'ArrowRight' ? 1 : k === 'ArrowUp' || k === 'ArrowLeft' ? -1 : 0;
      if (!d) return;
      e.preventDefault();
      stopAuto();
      goTo(cur + d);
      tour.querySelector<HTMLElement>(`.rail button[data-i="${cur}"]`)?.focus({ preventScroll: true });
    });

    // 자동 넘기기: 누르면 일정 간격으로 다음 단계로. 마지막 단계에서, 다른 버튼을 누르면, 무대가 화면 밖으로 나가면 멈춘다.
    const AUTO_MS = 5200; // ← 한 단계에 머무는 시간(밀리초)
    let auto = 0;
    function stopAuto() {
      if (!auto) return;
      clearInterval(auto); auto = 0;
      play.setAttribute('aria-pressed', 'false'); play.setAttribute('aria-label', play.dataset.play!);
    }
    function startAuto() {
      play.setAttribute('aria-pressed', 'true'); play.setAttribute('aria-label', play.dataset.pause!);
      goTo(cur >= N - 1 ? 0 : cur + 1);
      auto = window.setInterval(() => { if (cur >= N - 1) stopAuto(); else goTo(cur + 1); }, AUTO_MS);
    }
    play.addEventListener('click', (e) => { e.stopPropagation(); auto ? stopAuto() : startAuto(); });
    // 무대가 화면 밖으로 나가면 데모 화면의 타이머와 자동 넘기기를 멈추고, 다시 들어오면 지금 화면을 처음부터 돌린다
    new IntersectionObserver(([e]) => {
      const was = inView; inView = e.isIntersecting;
      if (!inView) { stopTimeline(); stopAuto(); return; }
      const pane = tour.querySelector<HTMLElement>(`.pane[data-i="${cur}"]`);
      if (!was && pane) run(pane);
    }).observe(stage);

    // ── 테마 전환: 노트북 화면이 한쪽부터 입자로 흩어지며 바뀐다 ──
    // 밝은 화면 ↔ 어두운 화면의 경계(front)가 화면을 가로지르고, 경계 양쪽에 반대편 색 입자를 뿌린다.
    const flip = tour.querySelector<HTMLElement>('.flip')!;
    const dust = tour.querySelector<HTMLCanvasElement>('.dust')!;
    const dctx = dust.getContext('2d');
    const photo = tour.querySelector<HTMLElement>('.p-photo');
    let sweepRaf = 0;
    const endSweep = () => {
      cancelAnimationFrame(sweepRaf); sweepRaf = 0;
      dctx?.clearRect(0, 0, dust.width, dust.height);
      flip.style.clipPath = '';
      scr.classList.remove('sweeping', 'photo-inv');
    };
    function sweep(toDark: boolean) { // toDark = 노트북 화면이 어두워지는 쪽 (사이트가 밝은 테마로 바뀔 때)
      endSweep();
      if (!dctx || reduce || document.hidden) return;
      const w = scr.clientWidth, h = scr.clientHeight, dpr = Math.min(devicePixelRatio || 1, 2);
      if (!w || !h) return;
      dust.width = w * dpr; dust.height = h * dpr; dctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const MS = 1000;           // ← 걸리는 시간(밀리초)
      const BAND = w * 0.26;     // ← 입자가 뿌려지는 띠의 너비 (경계 양쪽으로 이만큼씩)
      const LIGHT = '#ffffff', DARK = '#0d0d0d'; // 밝은 화면 바탕색, 뒤집힌 화면 바탕색 (.flip의 필터 결과와 같게)
      // 경계 바로 옆에서는 입자가 화면의 절반쯤을 덮어야 곧은 경계선이 눈에 띄지 않는다 → 입자 수를 화면 넓이에 맞춘다
      const specks = Array.from({ length: Math.round(w * h * 0.08) }, () => ({ x: Math.random() * w, y: Math.random() * h, s: 1.2 + Math.random() * 2.4, t: Math.random(), v: 0.4 + Math.random(), ph: Math.random() * 6.28 }));
      const dir = toDark ? -1 : 1; // 경계가 가는 방향: 어두워질 때는 오른쪽 → 왼쪽
      // 띠가 화면 밖에서 헛도는 시간을 줄이려고, 화면 가장자리 바로 바깥에서 출발해 바로 바깥에서 끝낸다
      const EDGE = BAND * 0.45;
      const fromF = toDark ? w + EDGE : -EDGE, toF = toDark ? -EDGE : w + EDGE;
      const box = scr.getBoundingClientRect(), pr = photo?.getBoundingClientRect();
      const px = pr ? pr.left + pr.width / 2 - box.left : 0;
      scr.classList.add('sweeping');
      const t0 = performance.now();
      const frame = (now: number) => {
        const u = Math.min(1, Math.max(0, (now - t0) / MS));
        const p = u < 0.5 ? 2 * u * u : 1 - Math.pow(-2 * u + 2, 2) / 2;
        const f = fromF + (toF - fromF) * p; // 경계의 x 위치. 이보다 오른쪽이 어두운 화면
        // 뒤집는 층은 경계 오른쪽만 남긴다. 곧은 선으로만 자른다: 비스듬한 모양(polygon)은 크롬이 뒤집기 효과에 그대로 적용하지 못한다
        flip.style.clipPath = `inset(0 0 0 ${Math.min(w, Math.max(0, f)).toFixed(1)}px)`;
        scr.classList.toggle('photo-inv', px > f);
        dctx.clearRect(0, 0, w, h);
        for (const tone of [DARK, LIGHT]) {
          dctx.fillStyle = tone;
          for (const q of specks) {
            const d = q.x - f;                               // +면 어두운 쪽, -면 밝은 쪽
            if ((d > 0) !== (tone === LIGHT)) continue;      // 어두운 쪽에는 밝은 입자, 밝은 쪽에는 어두운 입자
            const a = Math.abs(d) / (BAND * (0.75 + 0.25 * Math.sin(q.y / 37 + q.ph * 0.15))); // 띠 너비를 높이에 따라 조금씩 다르게
            if (a >= 1 || q.t > Math.pow(1 - a, 1.7)) continue;
            const blow = a * (1 - a) * 4 * q.v;              // 경계에서 조금 떨어진 입자가 가장 많이 날린다 (경계 바로 옆은 제자리에서 선을 가린다)
            dctx.fillRect(q.x + dir * 9 * blow * (d * dir > 0 ? 1 : 0.35), q.y + Math.sin(q.ph + u * 9) * 3 * blow, q.s, q.s);
          }
        }
        if (u < 1) sweepRaf = requestAnimationFrame(frame); else endSweep();
      };
      frame(t0); // 첫 장을 바로 그려 둔다: 테마가 바뀐 그 순간에 화면이 한꺼번에 뒤집혀 보이지 않게
      sweepRaf = requestAnimationFrame(frame);
    }
    new MutationObserver(() => sweep(document.documentElement.dataset.theme === 'light'))
      .observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

    // 주소가 #프로젝트id로 끝나면 그 단계에서 시작 (상세 페이지의 "돌아가기"가 이렇게 온다)
    const want = ids.indexOf(location.hash.slice(1));
    setStep(location.hash.length > 1 && want > 0 ? want : 0);
    document.fonts?.ready.then(placeHighlight);
  }
</script>

<style>
  @property --dl-raw { syntax: '<percentage>'; inherits: true; initial-value: 0%; }

  .tour {
    position: relative;
    --stage-h: calc(100vh - var(--bar-h));   /* 무대 높이 = 메뉴 막대를 뺀 한 화면 */
    --dev-w: clamp(340px, min(1040px, 100vw - 240px, (100vh - var(--bar-h) - 300px) * 1.5), 1040px); /* ← 300px = 제목·버튼 몫으로 남기는 높이 (아래 svh 줄도 같이) */
    --title: clamp(2.3rem, min(5.4vw, 8.2vh), 4.25rem);
    --dl-raw: 0%;
    transition: --dl-raw 0.9s ease;
  }
  @supports (height: 100svh) {
    .tour { --stage-h: calc(100svh - var(--bar-h)); --dev-w: clamp(340px, min(1040px, 100vw - 240px, (100svh - var(--bar-h) - 300px) * 1.5), 1040px); --title: clamp(2.3rem, min(5.4vw, 8.2svh), 4.25rem); }
  }
  /* JS가 없으면 단계를 넘길 수 없으니 넘기는 버튼을 감추고 첫 화면만 보여준다. 프로젝트는 아래 목록에 전부 있다 */
  :global(.no-js) .tour .controls, :global(.no-js) .tour .act [data-go] { display: none; }

  /* 바탕색(.shade)과 내용(.stage)을 같은 자리에 겹친다. 그 사이(z-index -1)로 화면 전체의 점 무늬가 지나간다 */
  .stage { position: relative; height: var(--stage-h); margin-top: calc(-1 * var(--stage-h)); overflow: hidden; display: grid; }
  .shade {
    --l: calc(var(--stage-l) + var(--dl-raw) * var(--stage-swing));
    position: relative; z-index: -2; height: var(--stage-h);
    background:
      linear-gradient(to bottom, transparent 82%, var(--color-paper)),
      radial-gradient(120% 70% at 50% 0%, hsl(0 0% calc(var(--l) + 5%)), hsl(0 0% var(--l)) 70%);
  }
  /* 밝은 테마에서는 노트북 화면을 뒤집어 어두운 화면으로 보여 준다. 바뀌는 순간에는 경계가 입자로 흩어지며 지나간다(스크립트) */
  .flip { position: absolute; inset: 0; z-index: 2; pointer-events: none; -webkit-backdrop-filter: invert(1) contrast(0.9); backdrop-filter: invert(1) contrast(0.9); clip-path: inset(0 0 0 100%); }
  :global([data-theme="light"]) .flip { clip-path: inset(0); }
  .dust { position: absolute; inset: 0; z-index: 3; width: 100%; height: 100%; pointer-events: none; }
  /* 사진은 뒤집힌 화면에서도 제 색이어야 하니 미리 한 번 뒤집어 둔다. 전환 중에는 경계가 사진을 지날 때 스크립트가 바꾼다 */
  :global([data-theme="light"]) .screen:not(.sweeping) :global(.p-photo), .screen.sweeping.photo-inv :global(.p-photo) { filter: invert(1); }

  .col { grid-area: 1 / 1; position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 0; padding: 12px 16px 16px; text-align: center; }

  /* 제목·버튼 묶음은 전부 같은 칸에 겹쳐 두고 하나만 보여준다 → 단계가 바뀌어도 아래 요소가 출렁이지 않는다 */
  .titles, .acts { display: grid; width: 100%; flex: none; }
  .t-item, .act { grid-area: 1 / 1; align-self: center; opacity: 0; visibility: hidden; transition: opacity 0.3s, transform 0.5s var(--ease-spring), filter 0.3s, visibility 0s 0.3s; }
  .t-item { transform: translateY(0.5rem) scale(0.985); filter: blur(6px); }
  .t-item.on, .act.on { opacity: 1; visibility: visible; transform: none; filter: none; transition-delay: 0.1s, 0.1s, 0.1s, 0s; }
  .t-item h1, .t-item h2 { font-size: var(--title); line-height: 1.06; letter-spacing: -0.04em; }
  .t-item p { max-width: 46rem; margin: 0.85rem auto 0; font-size: clamp(1rem, min(1.7vw, 2.6vh), 1.3rem); line-height: 1.45; letter-spacing: -0.015em; color: var(--color-ink-2); text-wrap: balance; }

  /* ── 노트북 ── 안쪽 치수는 전부 em이라 노트북 폭에 비례해 같이 줄어든다 */
  .device { position: relative; flex: none; width: var(--dev-w); margin-top: clamp(0.7rem, 2vh, 1.2rem); font-size: calc(var(--dev-w) / 76); }
  .lid { padding: 1.1em 1.1em 1.5em; border-radius: 1.9em 1.9em 0.3em 0.3em; background: #0a0a0b; box-shadow: inset 0 0 0 0.12em #3a3a3e, 0 0 0 0.1em rgba(255, 255, 255, 0.08), 0 3.5em 6em -2.5em rgba(0, 0, 0, 0.65); }
  .screen { position: relative; aspect-ratio: 16 / 10; overflow: hidden; border-radius: 0.9em 0.9em 0.2em 0.2em; background: #fff; container-type: inline-size; }
  .base { position: relative; height: 1.7em; margin: 0 -6.5%; border-radius: 0.3em 0.3em 1.6em 1.6em / 0.3em 0.3em 1.2em 1.2em; background: linear-gradient(#e6e7ea, #c9cbcf 45%, #9a9ca2); box-shadow: 0 1.6em 2.4em -1em rgba(0, 0, 0, 0.5); }
  .base::before { content: ""; position: absolute; left: 50%; top: 0; width: 13%; height: 0.55em; transform: translateX(-50%); border-radius: 0 0 0.6em 0.6em; background: #b3b5ba; }

  /* ── 점 레일 + 재생 버튼 ── */
  .controls { position: absolute; left: calc(100% + clamp(56px, 6vw, 120px)); top: 50%; transform: translateY(-50%); display: flex; flex-direction: column; align-items: center; gap: 8px; font-size: 1rem; }
  .rail { display: flex; flex: none; flex-direction: column; padding: 8px 0; border-radius: 20px; background: var(--btn2-bg); border: 1px solid var(--color-rule-strong); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px); } /* 표준 속성이 마지막이어야 빌드 후에도 남는다 (Base.astro .topbar 참고) */
  .rail button { position: relative; display: grid; place-items: center; width: 32px; height: 24px; padding: 0; border: 0; background: none; cursor: pointer; }
  .rail button i { width: 4px; height: 4px; border-radius: 4px; background: var(--color-ink-3); transition: width 0.4s var(--ease-spring), height 0.4s var(--ease-spring), background-color 0.2s; }
  .rail button:hover i { background: var(--color-ink); }
  .rail button[aria-current] i { height: 18px; background: var(--color-ink); }
  .tip { position: absolute; right: calc(100% + 10px); top: 50%; padding: 3px 8px; border-radius: 7px; background: var(--color-ink); color: var(--color-paper); font-size: 0.75rem; font-weight: 600; white-space: nowrap; opacity: 0; transform: translate(4px, -50%); pointer-events: none; transition: opacity 0.16s, transform 0.2s var(--ease-spring); }
  .rail button:hover .tip, .rail button:focus-visible .tip { opacity: 1; transform: translate(0, -50%); }
  .play { display: grid; flex: none; place-items: center; width: 32px; height: 32px; padding: 0; border-radius: 50%; border: 1px solid var(--color-rule-strong); background: var(--btn2-bg); color: var(--color-ink); cursor: pointer; transition: background-color var(--dur-base), transform var(--dur-fast); }
